# Copy to .env. The probe scripts write their own .env, so you only need this
# if you want to poke at the app by hand with `tina4 serve`.
#
# Flip TINA4_DEBUG between true and false and watch what changes:
#   true  -> landing page at /, dev footer, /__dev dashboard, browser opens
#   false -> / is a 404, no footer, /__dev is a 404 ... and the browser STILL opens
#
# sqlite means zero setup — no database is needed to reproduce any of these
# findings, since routes register at import time.
TINA4_DEBUG=true
TINA4_LOG_LEVEL=ALL
TINA4_DATABASE_URL=sqlite:///data/app.db
