// tina4-simple-agent — Codex-Desktop-inspired shell in tina4-js
const { signal, computed, effect, html, Tina4Element } = window.Tina4;

// Theme — three states: "system" (unstamped, follows OS), "light", "dark".
// Pre-paint script in index.html applies the saved value; this keeps it in sync.
const theme = signal((() => { try { return localStorage.getItem("t4a.theme") || "system"; } catch { return "system"; } })());
function applyTheme(t) {
  if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
  else document.documentElement.removeAttribute("data-theme");
}
function cycleTheme() {
  const order = ["system", "light", "dark"];
  const next = order[(order.indexOf(theme.value) + 1) % order.length];
  theme.value = next;
  try { next === "system" ? localStorage.removeItem("t4a.theme") : localStorage.setItem("t4a.theme", next); } catch {}
  applyTheme(next);
}

const settingsOpen = signal(false);
const draftEndpoint = signal("");
const draftModel = signal("");
const draftToken = signal("");
const draftWorkspace = signal("");
const draftMcpUrl = signal("");
const draftMcpToken = signal("");
const draftActorName = signal("");
const draftActorEmail = signal("");
const draftAutoSync = signal(false);
// Engine options — the rotating context window + extended cache TTL.
const draftGwContext = signal(true);
const draftGwKeepRounds = signal(10);
const draftGwK = signal(6);
const draftCache1h = signal(false);
// Thinking mode — Opus orchestrates, tina4-coder codes.
const draftThinking = signal(false);
const draftThinkingModel = signal("claude-opus-4-8");
const draftDelegateCap = signal(24);
const thinkingKeyAvailable = signal(true);
const actorInfo = signal({ name: "", email: "", autoSync: false });
// System-check (doctor) state
const doctorInfo = signal(null);      // { tina4, chrome, git, node, npm, python3, php, ruby, tina4Doctor, platform, arch }
const doctorLoading = signal(false);
const doctorPreparing = signal(false);
async function loadDoctor() {
  doctorLoading.value = true;
  try { doctorInfo.value = await fetch("/api/doctor").then(r => r.json()); } catch {}
  doctorLoading.value = false;
}
async function prepareSystem() {
  doctorPreparing.value = true;
  try { await fetch("/api/doctor/prepare", { method: "POST" }); await loadDoctor(); } catch {}
  doctorPreparing.value = false;
}
async function loadActor() {
  try {
    const j = await fetch("/api/actor").then(r => r.json());
    actorInfo.value = { name: j.name || "", email: j.email || "", autoSync: !!j.autoSync };
    draftActorName.value = actorInfo.value.name;
    draftActorEmail.value = actorInfo.value.email;
    draftAutoSync.value = actorInfo.value.autoSync;
  } catch {}
}
loadActor();
const turnStats = signal(null); // { elapsedMs, tokens, rounds }
const activeSkills = signal([]); // string[] of skill names in play this turn
const thoughts = signal([]); // rolling log of {kind, text, at} — shown below composer
const pendingChoices = signal([]); // quick-pick pills (from an `ask` frame) shown ABOVE the composer
let reasoningBuf = ""; // buffers streaming reasoning until sentence boundary
const promptQueue = signal([]); // queued user prompts submitted while streaming
const service = signal(null); // { pid, port, url, cmd } when a background service is up
const consoleOpen = signal(false); // developer CONSOLE (machinery/trace stream) — OFF by default
const consoleTab = signal("build"); // which log the console shows: build | app | server
const debugEvents = signal([]);    // capped ring buffer of {event, detail, at} for the console
// Which tab a log event belongs to, from its event name: app:* = the running app's console;
// server:* = the tina4 serve log; everything else = the agent's build machinery.
function logTabOf(ev) { const e = String(ev || ""); return e.startsWith("app:") ? "app" : e.startsWith("server:") ? "server" : "build"; }
// Steer a (possibly stuck) agent with a log line — send it as guidance the agent picks up next round.
function steerFromLog(text) {
  const t = String(text || "").trim(); if (!t) return;
  try { if (ws.readyState === 1) ws.send(JSON.stringify({ type: "steer", content: `Fix this — from the log: ${t.slice(0, 800)}` })); } catch {}
  think("steer", `steered from log: ${t.slice(0, 60)}`);
}
const fileTree = signal(null); // { root, tree: [...] }
const fileTreeOpen = signal(false);
const viewingFile = signal(null); // { path, content, size }
const activePlanPath = signal(null); // the plan the agent is currently following (e.g. "plan/MASTER.md")
// True when `p` is the plan the agent is actively following (path-tolerant: with/without leading ./).
const isActivePlan = (p) => {
  const a = activePlanPath.value; if (!a || !p) return false;
  const norm = (s) => String(s).replace(/^\.?\/+/, "");
  return norm(a) === norm(p);
};
const expandedDirs = signal({});
const turnStartAt = signal(0);
const turnElapsed = signal(0); // ms, ticks up while streaming
const sessionTokens = signal(0); // cumulative tokens
const cost = signal(null); // { total:{calls,tokensIn,tokensOut,ms}, byVendor, byActor } — real per-vendor usage (COST.md)
const activity = signal(""); // live agent feed line (from a delegated client's stream) under the composer
const sessionElapsed = signal(0); // cumulative agent time (ms)

let turnTimer = null;
function startTurnClock(startedAt) {
  turnStartAt.value = typeof startedAt === "number" && startedAt > 0 ? startedAt : Date.now();
  turnElapsed.value = Math.max(0, Date.now() - turnStartAt.value);
  clearInterval(turnTimer);
  turnTimer = setInterval(() => { turnElapsed.value = Date.now() - turnStartAt.value; }, 100);
}
function stopTurnClock() {
  clearInterval(turnTimer); turnTimer = null;
}

// ------------------ sessions ------------------
const sessionsRailOpen = signal(true);
const sessions = signal([]); // [{id, title, goal, status, createdAt, updatedAt}]
const currentSessionId = signal(null);
const currentSession = computed(() =>
  sessions.value.find((s) => s.id === currentSessionId.value) || null,
);
async function loadSessions() {
  try {
    const j = await fetch("/api/sessions").then((r) => r.json());
    sessions.value = Array.isArray(j?.sessions) ? j.sessions : [];
  } catch { sessions.value = []; }
}
// Reconstitute a display-friendly transcript from persisted OpenAI-shape messages.
// Shared by HTTP restore (activateSession) and WS replay (session:active), so a
// thread flip rebuilds the chat to exactly that thread's history.
function transcriptToDisplay(raw) {
  const display = [];
  for (const m of (Array.isArray(raw) ? raw : [])) {
    // Hide internal, model-only injections (auto-continue nudges, steer/preview-error
    // relays) — they're for the agent, not something the user should read in chat.
    if (m.role === "user" && typeof m.content === "string" && m.content.startsWith("[[tina4:internal]]")) continue;
    // Carry the stored timestamp through. The renderer draws `m.at` when it is there, and rebuilding
    // these objects without it is why a reloaded session came back with every time missing.
    if (m.role === "user" && typeof m.content === "string") display.push({ role: "user", content: m.content, at: m.at });
    else if (m.role === "assistant" && typeof m.content === "string" && m.content) display.push({ role: "assistant", content: m.content, at: m.at });
    else if (m.role === "assistant" && Array.isArray(m.tool_calls)) {
      for (const tc of m.tool_calls) {
        let args = {}; try { args = JSON.parse(tc.function?.arguments || "{}"); } catch {}
        display.push({ role: "tool", at: m.at, card: { name: tc.function?.name || "tool", args, result: { ok: true } } });
      }
    }
  }
  // Collapse consecutive NON-file tool cards (grounding/context/test noise) to the last one, but KEEP
  // every write_file card so a reloaded build shows its real file history — matching the LIVE view
  // (owner: "refresh didn't load all the history"). A streak is only collapsed if it has no file writes.
  const collapsed = [];
  for (let i = 0; i < display.length; i++) {
    if (display[i].role === "tool") {
      let j = i;
      while (j + 1 < display.length && display[j + 1].role === "tool") j++;
      const streak = display.slice(i, j + 1);
      const fileCards = streak.filter((c) => c.card && c.card.name === "write_file");
      if (fileCards.length) collapsed.push(...fileCards);   // keep all file writes
      else collapsed.push(streak[streak.length - 1]);        // non-file streak → last only
      i = j;
    } else collapsed.push(display[i]);
  }
  return collapsed;
}

async function activateSession(id) {
  // RE-activating the session we're already on (e.g. to re-attach and flush queued sends) must NOT
  // reload the transcript — that would wipe messages the user just pushed but hasn't sent yet.
  const reattachSame = currentSessionId.value === id && messages.value.length > 0;
  threadAttached = false;   // (re)attaching — user sends queue until the new thread:attached lands
  currentSessionId.value = id;
  localStorage.setItem("t4a.sessionId", id);
  if (!reattachSame) {
    try {
      const j = await fetch("/api/sessions/" + id).then((r) => r.json());
      messages.value = transcriptToDisplay(j?.messages);
    } catch { messages.value = []; }
  }
  // Carry THIS view's project so the server keys/routes the thread to it — not a
  // shared global that another open tab could have changed underneath us.
  if (ws.readyState === 1) ws.send(JSON.stringify({ type: "session:activate", id, project: projectsList.value.current || "" }));
}
async function createSession(title, goal, subpath) {
  const j = await fetch("/api/sessions", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ title: title || "New session", goal: goal || "", subpath: subpath || "" }) }).then((r) => r.json());
  await loadSessions();
  if (j?.id) await activateSession(j.id);
  return j;
}
async function updateSession(id, patch) {
  await fetch("/api/sessions/" + id, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(patch) });
  await loadSessions();
}
async function deleteSessionById(id) {
  await fetch("/api/sessions/" + id, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ action: "delete" }) });
  if (currentSessionId.value === id) { currentSessionId.value = null; messages.value = []; localStorage.removeItem("t4a.sessionId"); }
  await loadSessions();
}

// ------------------ signals ------------------
const messages = signal([]); // {role: 'user'|'assistant'|'tool', content, card?}
const streaming = signal(false);
const modelInfo = signal({ model: "…", endpoint: "", workspace: "", projectsRoot: "", currentProject: "" });
// Keep the real per-project usage (from /api/model → cost) in the `cost` signal so the header shows
// tokens on a fresh load/refresh, not just live during a turn.
effect(() => { const c = modelInfo.value?.cost; if (c && c.total) cost.value = c; });
const projectsList = signal({ projectsRoot: "", current: "", projects: [] });
const projectsLoaded = signal(false);
// Isolation Part B: tag every project-scoped request with THIS tab's project so the server serves
// the right one (concurrent tabs never share a global). `pfetch` adds the X-Project header; the
// preview iframe uses a /workspace/@<project>/ path so its relative assets stay in-project.
const projHeaders = (extra) => { const p = projectsList.value.current || ""; return p ? { "X-Project": p, ...(extra || {}) } : (extra || {}); };
const pfetch = (url, opts) => fetch(url, { ...(opts || {}), headers: projHeaders((opts || {}).headers) });
const wsBase = () => { const p = projectsList.value.current || ""; return p ? `/workspace/@${p}` : "/workspace"; };
// Level-3 multi-thread: server broadcasts thread:list frames as actors change status.
// Each entry: {key, project, sessionId, title, status, rounds, totalElapsedMs, totalTokens, subscriberCount}
const threads = signal([]);
const attachedThreadKey = signal(null);
const draftProjectsRoot = signal("");
async function loadProjectsList() {
  try { projectsList.value = await fetch("/api/projects").then(r => r.json()); } catch {}
  projectsLoaded.value = true;
}

// ---- git branch switching ----
const branchInfo = signal({ current: null, branches: [] });
const branchMenuOpen = signal(false);
async function loadBranches() {
  try { branchInfo.value = await fetch("/api/branches").then(r => r.json()); } catch { branchInfo.value = { current: null, branches: [] }; }
}
async function switchBranch(name, action) {
  const j = await fetch("/api/branches", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ name, action }) }).then(r => r.json()).catch(() => ({ ok: false, error: "request failed" }));
  if (!j.ok) { alert("Branch: " + (j.error || "failed")); return j; }
  branchMenuOpen.value = false;
  await loadBranches();
  // Branch switch changes files on disk — refresh the whole project view.
  await _rescopeAfterProjectChange();
  think("ok", "on branch " + (j.current || name));
  return j;
}
const hasProject = computed(() =>
  !!(projectsList.value.current) && (projectsList.value.projects || []).length > 0
);
const isFirstRun = computed(() =>
  projectsLoaded.value && (projectsList.value.projects || []).length === 0
);
async function _rescopeAfterProjectChange() {
  modelInfo.value = await fetch("/api/model").then(r => r.json());
  // Clear the stale session pointer — sessions live inside the workspace.
  currentSessionId.value = null;
  localStorage.removeItem("t4a.sessionId");
  messages.value = [];
  // Stop any process-wide preview service from the previous project so we don't
  // preview stale bytes; ignore errors (nothing running is fine).
  fetch("/api/service/stop", { method: "POST" }).catch(() => {});
  service.value = null;
  previewNonce.value = 1;
  previewClosed.value = false;
  // Drop ALL file-view state tied to the previous project — otherwise an open
  // file viewer or an expanded tree node re-stats a path under the OLD project
  // and throws ENOENT once the workspace has moved. Clearing forces a fresh
  // load against the NEW working folder.
  viewingFile.value = null;
  expandedDirs.value = {};
  fileTree.value = null;
  await loadProject();
  await loadSessions();
  await loadProjectsList();
  await loadSecrets();
  loadBranches();
  refreshTree();
  refreshPreviewManifest();
  projectOpen.value = false;
  // Cross-machine resume: ask the server for the last session this actor was on
  // in this project. If it exists in the list we just loaded, activate it.
  try {
    const lo = await fetch("/api/session/last-open").then(r => r.json());
    if (lo?.lastSession && sessions.value.some((s) => s.id === lo.lastSession)) {
      await activateSession(lo.lastSession);
    }
  } catch {}
}
async function switchProject(name) {
  const j = await fetch("/api/projects", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ name, action: "switch" }) }).then(r => r.json());
  if (j?.ok) await _rescopeAfterProjectChange();
  return j;
}
async function createProject(name) {
  const j = await fetch("/api/projects", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ name }) }).then(r => r.json());
  if (j?.ok) await _rescopeAfterProjectChange();
  return j;
}
loadProjectsList();

// Cross-machine resume on boot — once sessions have loaded, if this actor
// has a last-open pointer that matches an existing session, jump straight to it.
let _resumeTried = false;
effect(() => {
  if (!hasProject.value || _resumeTried || currentSessionId.value) return;
  if ((sessions.value || []).length === 0) return;
  _resumeTried = true;
  (async () => {
    try {
      const lo = await fetch("/api/session/last-open").then(r => r.json());
      if (lo?.lastSession && sessions.value.some((s) => s.id === lo.lastSession)) {
        await activateSession(lo.lastSession);
      }
    } catch {}
  })();
});

// First-run onboarding — if the projects folder is empty, open New Project
// automatically and keep the composer disabled until one exists.
effect(() => {
  if (isFirstRun.value && !newProjectOpen.value) newProjectOpen.value = true;
});

// Default to "efficient" — the balanced sweet spot. Meticulous is thorough but
// slow, especially with the hosted tina4-coder (heavy reasoning); a fresh user
// gets a responsive build out of the box and can opt into meticulous per turn.
const agentMode = signal(localStorage.getItem("t4a.mode") || "efficient"); // "quick" | "efficient" | "meticulous"
effect(() => localStorage.setItem("t4a.mode", agentMode.value));
const previewNonce = signal(1); // start "on" — user can close
const previewClosed = signal(false); // user closed the preview
const previewHtml = signal("index.html"); // which workspace html the pane shows (agent switches it on write)
const previewVisible = computed(() => (previewNonce.value > 0 || !!service.value) && !previewClosed.value);
const hasStarted = computed(() => messages.value.length > 0);

// ------------------ WS (auto-reconnecting) ------------------
const wsProto = location.protocol === "https:" ? "wss:" : "ws:";
let ws;                        // reassigned on each (re)connect
let wsReconnectDelay = 500;    // backoff, grows to a cap
let wsEverConnected = false;
function connectWS() {
  ws = new WebSocket(`${wsProto}//${location.host}/ws/agent`);
  ws.addEventListener("open", handleWsOpen);
  ws.addEventListener("message", handleWsMessage);
  ws.addEventListener("close", handleWsClose);
  ws.addEventListener("error", handleWsError);
}
let lastActivityAt = Date.now();
// Catch-up replay window: between session:active and thread:attached the server
// re-sends this thread's buffered frames. We already rebuilt the transcript from
// the persisted replay, so we SWALLOW those frames (avoids doubling the chat) and
// collapse their thought-clouds down to just the last one.
let replaying = false;
let replayTimer = null; // bounds how long we swallow catch-up frames after a session switch
let lastReplayThought = null;
setInterval(() => {
  if (streaming.value && Date.now() - lastActivityAt > 180_000) {
    // 3 min without a delta/tool/frame — assume stuck, force reset.
    dropTrailingEmpty();
    push({ role: "tool", card: { name: "error", result: { ok: false, error: "stuck for 3 minutes — resetting. Backend or model may be down." } } });
    streaming.value = false;
    stopTurnClock();
    think("err", "auto-reset: 3 min silence");
    lastActivityAt = Date.now();
  }
}, 5000);
function handleWsClose() {
  threadAttached = false;                 // a new socket must re-attach before user sends go out
  if (streaming.value) { streaming.value = false; stopTurnClock(); }
  // Auto-reconnect with backoff — no manual reload needed. handleWsOpen
  // re-activates the current session so the thread reattaches.
  think("round", "reconnecting…");
  setTimeout(connectWS, wsReconnectDelay);
  wsReconnectDelay = Math.min(wsReconnectDelay * 2, 8000);
}
function handleWsError() { /* the close event fires next and drives reconnect */ }

function push(m) { messages.value = [...messages.value, m]; }
function updateLastAssistant(fn) {
  const arr = messages.value;
  for (let i = arr.length - 1; i >= 0; i--) {
    if (arr[i].role === "assistant") {
      const copy = { ...arr[i] };
      fn(copy);
      messages.value = [...arr.slice(0, i), copy, ...arr.slice(i + 1)];
      return;
    }
  }
}
let thoughtId = 0;
function think(kind, text) {
  // Thought clouds are plain faint text — strip markdown syntax so raw "**", "`",
  // "##", "~~" don't show (e.g. "Results:**"). Keep words, punctuation, emoji.
  text = String(text || "")
    .replace(/\*\*/g, "")            // bold **
    .replace(/(^|[\s(])\*(?=\S)/g, "$1") // stray * bullets/italics
    .replace(/`+/g, "")              // inline code ticks
    .replace(/~~/g, "")              // strikethrough
    .replace(/^\s{0,3}#{1,6}\s+/gm, "") // heading hashes
    .replace(/[ \t]{2,}/g, " ")
    .trim();
  // Merge with the most recent thought if it's the same kind and fresh (<3s old)
  // — avoids "these two clouds should have been one".
  const now = Date.now();
  const prev = thoughts.value[0];
  if (prev && prev.kind === kind && now - prev.at < 3000 && (prev.text.length + text.length) < 500) {
    const merged = { ...prev, text: (prev.text + " " + text).trim(), at: now };
    thoughts.value = [merged, ...thoughts.value.slice(1)];
    return;
  }
  const id = ++thoughtId;
  const scale = 0.8 + Math.random() * 0.25;         // 0.8 – 1.05
  const dy = Math.round(Math.random() * 30);         // small vertical wobble
  const t = { id, kind, text, at: now, scale, dy };
  thoughts.value = [t, ...thoughts.value].slice(0, 8);
  setTimeout(() => {
    thoughts.value = thoughts.value.filter((x) => x.id !== id);
  }, 15000);
}

function ensureAssistantBubble() {
  const arr = messages.value;
  if (!arr.length || arr[arr.length - 1].role !== "assistant") {
    push({ role: "assistant", content: "", reasoning: "", startedAt: Date.now(), at: Date.now(), skills: activeSkills.value });
  }
}
function dropTrailingEmpty() {
  const arr = messages.value;
  if (arr.length && arr[arr.length - 1].role === "assistant" && arr[arr.length - 1].content === "") {
    messages.value = arr.slice(0, -1);
  }
}

// A user message must only go out on a socket whose thread is ATTACHED — otherwise the server
// replies "no thread attached" (this bit the user when a restart dropped the socket and their
// message raced the auto re-activate). Track attachment, queue sends that arrive un-attached, and
// flush them the moment `thread:attached` lands.
let threadAttached = false;
let pendingWsSends = [];
function wsSendWhenAttached(obj) {
  if (ws && ws.readyState === 1 && threadAttached) { ws.send(JSON.stringify(obj)); return true; }
  // Not attached yet (fresh session or reconnect): queue, then trigger a (safe) re-attach so the
  // queue actually flushes — otherwise a message can strand silently (the "not stacking / no
  // response" bug). activateSession no longer wipes the current session's messages, so this is safe.
  pendingWsSends.push(obj);
  if (ws && ws.readyState === 1 && !threadAttached) {
    const id = currentSessionId.value || (() => { try { return localStorage.getItem("t4a.sessionId"); } catch { return null; } })();
    if (id) activateSession(id);
  }
  return false;
}
function flushPendingWsSends() {
  if (!threadAttached || !ws || ws.readyState !== 1 || !pendingWsSends.length) return;
  const q = pendingWsSends; pendingWsSends = [];
  for (const o of q) ws.send(JSON.stringify(o));
}

async function handleWsOpen() {
  wsReconnectDelay = 500;                 // reset backoff on a good connect
  if (wsEverConnected) think("ok", "reconnected");
  wsEverConnected = true;
  await loadSessions();
  // On (re)connect resume the session the user is on so the running thread
  // reattaches and streaming resumes — no manual reload after a server restart.
  const wanted = currentSessionId.value || localStorage.getItem("t4a.sessionId");
  const found = sessions.value.find((s) => s.id === wanted);
  if (found) await activateSession(found.id);
  else if (sessions.value[0]) await activateSession(sessions.value[0].id);
  // else: leave unset; the composer will lazy-create on first send
}

function handleWsMessage(ev) {
  let f; try { f = JSON.parse(ev.data); } catch { return; }
  lastActivityAt = Date.now();
  if (f.type === "thread:list") { threads.value = Array.isArray(f.threads) ? f.threads : []; return; }
  if (f.type === "thread:attached") {
    attachedThreadKey.value = f.key;
    threadAttached = true;
    flushPendingWsSends();               // release any user messages queued during the reconnect
    // End of catch-up: show just the LAST thought from the replayed stream.
    replaying = false;
    if (lastReplayThought) { think(lastReplayThought.kind, lastReplayThought.text); lastReplayThought = null; }
    return;
  }
  if (f.type === "session:active") {
    sessionElapsed.value = f.totalElapsedMs ?? 0;
    // Include the RUNNING turn's tokens: they aren't folded into the session totals until turn:done,
    // so re-attaching mid-build otherwise showed a figure that ignored the work in progress.
    sessionTokens.value = (f.totalTokens ?? 0) + (f.inflightTokens ?? 0);
    // The header prefers the PROJECT cost ledger over the session counter, and nothing refreshed it
    // on a switch — so it kept showing the previous project's tokens. Re-read it for the session we
    // just moved to (the server returns the folded ledger with /api/model).
    fetch("/api/model").then((r) => r.json()).then((j) => {
      modelInfo.value = j;
      if (j && j.cost && j.cost.total) cost.value = j.cost; else cost.value = null;
    }).catch(() => {});
    // Only rebuild + swallow the catch-up buffer when SWITCHING to a DIFFERENT
    // session/thread. For the session we're already on (initial activate,
    // reconnect, or the first prompt that just created this session) we must NOT
    // wipe freshly-pushed messages or swallow the turn that's starting.
    const switching = !!f.id && f.id !== currentSessionId.value;
    if (f.id) { currentSessionId.value = f.id; try { localStorage.setItem("t4a.sessionId", f.id); } catch {} }
    if (switching) {
      if (Array.isArray(f.replay)) messages.value = transcriptToDisplay(f.replay);
      replaying = true;          // swallow the buffered catch-up frames that follow
      lastReplayThought = null;
      thoughts.value = [];
      streaming.value = false;
      previewClosed.value = false;
      previewHtml.value = "index.html"; // new session starts on the default page
      previewNonce.value = Date.now();
      refreshPreviewManifest();
      // TIME-BOUND the swallow. The catch-up buffer drains in a few frames; without an
      // end condition, replaying stayed true forever and ate the LIVE build's feedback
      // (and every subsequent turn) — the "I get no feedback / subsequent chats dead" bug.
      // After a short beat, live frames must render again.
      if (replayTimer) clearTimeout(replayTimer);
      replayTimer = setTimeout(() => { replaying = false; }, 600);
    }
    return;
  }
  // During the brief catch-up window we ONLY swallow reasoning clouds (the transcript replay
  // already captured them). VISIBLE feedback — deltas (⌨/💬/✅ lines), tool cards, file cards,
  // turn markers — must ALWAYS render live, or the build looks dead until a refresh. A live
  // turn:start also exits replay mode entirely (fixes subsequent chats not working).
  if (replaying) {
    if (f.type === "turn:start") { replaying = false; if (replayTimer) { clearTimeout(replayTimer); replayTimer = null; } /* fall through — render it */ }
    else if (f.type === "reasoning") { if (f.content) lastReplayThought = { kind: "reason", text: String(f.content).slice(0, 360) }; return; }
    // everything else (delta / tool / files / turn:done / preview / …) falls through and renders
  }
  if (f.type === "turn:start") {
    replaying = false;   // a live turn must NEVER be swallowed as catch-up
    streaming.value = true;
    // Resume from the turn's REAL start time when the frame carries it (a replayed turn:start after
    // switching sessions must not restart the counter from zero).
    startTurnClock(typeof f.at === "number" ? f.at : undefined);
    activeSkills.value = Array.isArray(f.skills) ? f.skills : [];
    reasoningBuf = "";
    // REMOVE every tool card from prior turns so the chat stays clean — they
    // disappear, they don't fade or stack. (The transcript keeps the real record.)
    const arr0 = messages.value.filter((m) => m.role !== "tool");
    if (arr0.length !== messages.value.length) messages.value = arr0;
    // ALWAYS start a FRESH assistant bubble for a new turn — reusing the previous turn's bubble
    // concatenated this turn's deltas onto the last turn's report ("…preview at :7150🧠 Thinker
    // is drafting the plan…"). A new turn = a new bubble.
    push({ role: "assistant", content: "", reasoning: "", startedAt: Date.now(), at: Date.now(), skills: activeSkills.value });
  } else if (f.type === "reasoning") {
    // Counter-based flush — emit ONE prose cloud per chunk-batch. Reject code-y or
    // too-short fragments so you never see clouds saying "html }" or "Tina4;".
    reasoningBuf += f.content;
    window._reasChunks = (window._reasChunks || 0) + 1;
    // Flush at a SENTENCE boundary once the buffer has enough substance — never
    // mid-word. If the counter fires but no terminator is in the buffer yet, keep
    // waiting until one arrives (or we hit the hard char cap).
    const hasBigBreak = /\n\s*\n/.test(reasoningBuf);
    // Flush sooner — some models (tina4-coder) stream terse, fragmented reasoning
    // that rarely hits the old 900-char / 60-chunk bar, so almost no clouds showed.
    const bigEnough = window._reasChunks >= 30 || reasoningBuf.length >= 400 || hasBigBreak;
    if (!bigEnough) return;
    // Prefer a sentence boundary, but don't wait forever for one.
    const term = reasoningBuf.match(/^[\s\S]*[.!?][\s"'\)]*(?=\s|$)/);
    const hardCap = reasoningBuf.length >= 500; // flush even without a terminator
    if (!term && !hardCap) return;
    const cut = term ? term[0].length : reasoningBuf.length;
    const raw = reasoningBuf.slice(0, cut);
    reasoningBuf = reasoningBuf.slice(cut);
    window._reasChunks = 0;
    // Strip code — keep only prose. Removes fenced/inline code, HTML/XML tags,
    // any dangling opening backticks, and any line that reads as structural.
    const stripped = raw
      .replace(/```[\s\S]*?```/g, " ")                             // fenced blocks
      .replace(/```[\s\S]*$/g, " ")                                // dangling opening ``` at EOF
      .replace(/`[^`\n]+`/g, " ")                                  // inline `code`
      .replace(/`/g, " ")                                          // any remaining stray backticks
      .replace(/<\/?[a-zA-Z][^>\n]*>/g, " ")                       // html/xml tags
      .replace(/&[a-z#0-9]+;/gi, " ")                              // stray entities
      .split(/\n/)
      .filter(line => {
        const s = line.trim();
        if (!s) return false;
        if (/[{};]\s*$/.test(s)) return false;                     // ends with ; { }
        if (/=>/.test(s)) return false;                            // arrow fn
        if (/^(const|let|var|function|return|import|export|class|if|for|while|await|throw|new)\b/.test(s)) return false;
        if (/^[\s\S]{0,3}[·•\-\*]\s/.test(s) && /[{};]/.test(s)) return false; // bullet+code
        if (/^\s*\/\//.test(s)) return false;                      // // line comment
        if (/^\s*\/\*|\*\/\s*$/.test(s)) return false;             // /* … */
        if (/^[\s\S]{0,20}[{}]$/.test(s)) return false;            // dangling brace
        const letters = (s.match(/[A-Za-z]/g) || []).length;
        const punct   = (s.match(/[{}();=<>+\-*/&|,.\[\]]/g) || []).length;
        return punct <= letters * 0.35;
      })
      .join(" ")
      .replace(/\s+/g, " ")
      .trim();
    const words = stripped.split(/\s+/).filter(Boolean);
    if (stripped.length < 45 || words.length < 7) return;          // let shorter but real thoughts through
    // Repetition detector: if the text contains the same 4-word phrase 3+ times,
    // it's Qwen looping on a template — drop it and abort the turn's reasoning stream.
    const phrases = words.slice(0, -3).map((_, i) => words.slice(i, i + 4).join(" ").toLowerCase());
    const counts = new Map();
    for (const p of phrases) counts.set(p, (counts.get(p) || 0) + 1);
    if ([...counts.values()].some(c => c >= 3)) {
      console.warn("[cloud] repetitive template — dropped:", stripped.slice(0, 80));
      return;
    }
    // Same-as-last: if this cloud has >70% word overlap with the most recent cloud, drop.
    const prev = thoughts.value[0];
    if (prev && prev.text) {
      const prevWords = new Set(prev.text.toLowerCase().split(/\s+/));
      const shared = words.filter(w => prevWords.has(w.toLowerCase())).length;
      if (shared / words.length > 0.7) return;
    }
    const twoSent = stripped.match(/^[\s\S]*?[.!?]\s+[\s\S]*?[.!?]/);
    const preview = (twoSent ? twoSent[0] : stripped.slice(0, 320)).trim();
    think("reason", preview.length > 360 ? preview.slice(0, 357) + "…" : preview);
  } else if (f.type === "delta") {
    ensureAssistantBubble();
    updateLastAssistant((m) => (m.content += f.content));
  } else if (f.type === "cost") {
    // Real per-vendor usage from the project cost ledger (COST.md). Drives the header token counter
    // (the deterministic build never reported tokens) + a per-vendor breakdown tooltip.
    cost.value = f;
    if (f.total) sessionTokens.value = (f.total.tokensIn || 0) + (f.total.tokensOut || 0);
  } else if (f.type === "activity") {
    // Live agent feed from a delegated client (Cursor/Codex/Claude) — a single line that updates.
    activity.value = f.text || "";
  } else if (f.type === "autopilot") {
    // Server toggled auto-pilot (e.g. it turns OFF when a task completes) — reflect it in the UI.
    modelInfo.value = { ...modelInfo.value, autoPilot: !!f.on };
  } else if (f.type === "project:switched") {
    // The agent focused this session on a project the user NAMED — follow it: update the current
    // project, reload the tree + preview so the UI shows the app that's actually being edited.
    if (f.project) {
      projectsList.value = { ...projectsList.value, current: f.project };
      modelInfo.value = { ...modelInfo.value, currentProject: f.project };
      if (f.key) attachedThreadKey.value = f.key;
      loadProjectsList();
      refreshTree();
      refreshPreviewManifest();
      previewClosed.value = false;
      previewNonce.value = Date.now();
    }
  } else if (f.type === "image") {
    // An image the agent generated — show it inline in the chat feed.
    dropTrailingEmpty();
    push({ role: "image", url: f.url, path: f.path, prompt: f.prompt, at: Date.now() });
  } else if (f.type === "skill") {
    // Skill marker signal — the active Tina4 skill (tina4-python / tina4-js …). Drives the
    // per-message header badge so the user sees which skill is steering each file.
    activeSkills.value = f.name ? [f.name] : [];
  } else if (f.type === "files") {
    // A build manifest: render a compact card of clickable short-name file links with a
    // copy-path icon each — not a wall of full paths. (User: "clickable links - no need to
    // show the whole path - copy icons copy the path.")
    dropTrailingEmpty();
    const arr = messages.value.slice();
    const planPath = f.planPath || "plan/MASTER.md";
    activePlanPath.value = planPath;   // the plan the agent is now following
    arr.push({ role: "files", label: f.label || "Building", files: Array.isArray(f.files) ? f.files : [], planPath });
    messages.value = arr;
  } else if (f.type === "tool") {
    dropTrailingEmpty();
    // KEEP file-write cards (the diffs) so every built file stays visible; collapse only the
    // consecutive NON-file tool cards (grounding/context/test noise). Stamp each card with the
    // active skill so its header badges tina4-python (backend) / tina4-js (frontend).
    const arr = messages.value.slice();
    while (arr.length && arr[arr.length - 1].role === "tool" && arr[arr.length - 1].card && arr[arr.length - 1].card.name !== "write_file") arr.pop();
    arr.push({ role: "tool", card: f, skills: activeSkills.value.slice(), at: Date.now() });
    messages.value = arr;
    // Keep the workspace folder live: refresh the tree the moment a file is written or removed.
    if (/^(write_file|delete_file|move_file|rename_file)$/.test(f.name || "")) refreshTree();
  } else if (f.type === "service") {
    service.value = f.service || null;
    if (f.service) {
      previewNonce.value = Date.now();
      previewClosed.value = false;
      think("preview", `service up on :${f.service.port} → ${f.service.url}`);
    } else {
      // Service ended — revert the preview to the static workspace/index.html
      // instead of leaving it stuck on the dead service URL (blank/frozen).
      previewNonce.value = Date.now();
      previewClosed.value = false;
      think("preview", "service stopped");
    }
  } else if (f.type === "preview:refresh") {
    // Show progress as the agent works: refresh the file tree AND the static
    // preview iframe on every changed write — even mid-turn. Each write_file is a
    // complete file (and plan ticks are writes too), so the user sees the app the
    // moment it exists instead of staring at a blank pane until the turn ends.
    // Don't fight a running dev server's own HMR (only bump the static preview).
    refreshTree();
    // The agent tells us which html it just wrote — switch the pane to that page so
    // a differently-named file (e.g. system-review.html) is what you actually see.
    if (f.htmlPath) previewHtml.value = f.htmlPath;
    if (!service.value) {
      previewNonce.value = Date.now();
      previewClosed.value = false;
    }
  } else if (f.type === "preview:error") {
    // The live preview reported a runtime error; the server has queued it for the agent.
    think("err", `preview error: ${String(f.error).slice(0, 120)}`);
  } else if (f.type === "preview:error:injected") {
    think("preview", `handed ${f.count} preview error${f.count === 1 ? "" : "s"} to the agent as bug${f.count === 1 ? "" : "s"}`);
  } else if (f.type === "round") {
    // no cloud — round telemetry appears in the top-bar cumulative + AGENT stats
  } else if (f.type === "turn:done") {
    streaming.value = false;
    activity.value = "";
    stopTurnClock();
    sessionTokens.value += f.tokens ?? 0;
    sessionElapsed.value += f.elapsedMs ?? 0;
    // Mark the final tool streak as finished so it fades out after a beat
    const arr = messages.value.slice();
    let flipped = false;
    for (let i = arr.length - 1; i >= 0; i--) {
      if (arr[i].role !== "tool") break;
      arr[i] = { ...arr[i], finished: true, stale: true };
      flipped = true;
    }
    if (flipped) messages.value = arr;
    // Agent has validated — refresh what we own. When a tina4/dev-server is running,
    // trust the framework's own DevReload (WebSocket-based hot-reload) — do NOT force
    // an iframe swap or we'll fight its HMR. Only bump nonce for the static file preview.
    if (!service.value) {
      previewNonce.value = Date.now();
      previewClosed.value = false;
    }
    refreshTree();
    refreshPreviewManifest();
    // refresh sessions list so updatedAt / previews reflect the new state
    loadSessions();
    const arr2 = messages.value;
    for (let i = arr2.length - 1; i >= 0; i--) {
      if (arr2[i].role === "assistant") {
        const copy = { ...arr2[i], stats: { elapsedMs: f.elapsedMs, tokens: f.tokens, rounds: f.rounds } };
        messages.value = [...arr2.slice(0, i), copy, ...arr2.slice(i + 1)];
        break;
      }
    }
    dropTrailingEmpty();
    // Flush any trailing reasoning that didn't hit a sentence boundary.
    if (reasoningBuf.trim().length >= 3) think("reason", reasoningBuf.trim());
    reasoningBuf = "";
    // fire any queued prompt
    setTimeout(flushQueueIfIdle, 100);
  } else if (f.type === "turn:cancelled") {
    streaming.value = false;
    stopTurnClock();
    dropTrailingEmpty();
    think("err", "■ stopped by you");
  } else if (f.type === "turn:complete") {
    think("ok", "✔ " + (f.message || "Done."));
    // Post a real, persistent chat line so completion is visible even when the
    // model emitted no content of its own (tina4-coder routes everything to
    // reasoning). Don't duplicate if the assistant already ended with text.
    const msg = (f.message || "Done.").trim();
    const arrC = messages.value;
    const lastA = [...arrC].reverse().find((m) => m.role === "assistant");
    const alreadySaid = lastA && typeof lastA.content === "string" && lastA.content.trim().length > 0;
    if (!alreadySaid) {
      dropTrailingEmpty();
      push({ role: "assistant", content: msg.startsWith("✔") ? msg : "✅ " + msg, at: Date.now(), done: true });
    }
  } else if (f.type === "autocontinue") {
    // The turn tried to stop but the plan still has open steps — the engine
    // nudged it to continue. Surface it so the user sees why it kept going.
    think("round", `continuing — ${f.open} plan step${f.open === 1 ? "" : "s"} left${f.next ? ": " + String(f.next).replace(/^-\s*\[ \]\s*/, "").slice(0, 60) : ""}`);
  } else if (f.type === "stuck") {
    // IT IS STUCK AND IT IS ASKING. The invitation itself already streamed as the message; this card
    // is the OPTIONAL code. Nobody is made to open it - the pills above the composer are a complete
    // answer on their own - but for someone who can read it, or wants to learn, the suspect line is
    // marked and the box is editable.
    push({ role: "tool", card: { name: "stuck_code", result: { ok: true, ...f } } });
    think("ask", `stuck on ${f.file}${f.suspectLine ? " around line " + f.suspectLine : ""}`);
  } else if (f.type === "ask") {
    // The question text is streamed as the assistant message (say); here we ONLY surface the options
    // as quick-pick pills ABOVE the composer. (Pushing an ask_user card here left an empty bubble.)
    pendingChoices.value = Array.isArray(f.options) ? f.options.filter(Boolean) : [];
    think("ask", "agent asked: " + (f.question || "?"));
  } else if (f.type === "decision") {
    // Agent wrote a decision into the plan. Open the plan editor scrolled to it,
    // in decision mode (Save & Continue resumes the agent with the edited plan).
    think("ask", "decision needed — opening the plan: " + (f.question || ""));
    push({ role: "tool", card: { name: "decide_in_plan", result: { ok: true, question: f.question, options: f.options || [], planPath: f.planPath } } });
    pfetch("/api/file?path=" + encodeURIComponent(f.planPath))
      .then((r) => r.json())
      .then((j) => {
        if (j.error) return;
        viewingFile.value = { ...j, decision: { planPath: f.planPath, anchor: f.anchor, question: f.question } };
      });
  } else if (f.type === "error") {
    dropTrailingEmpty();
    push({ role: "tool", card: { name: "error", result: { ok: false, error: f.error } } });
    streaming.value = false;
    stopTurnClock();
    think("err", `error: ${f.error}`);
    // Orphaned session (its project/session was deleted, e.g. after a projects reset): the thread
    // can never attach, so queued sends would strand forever. Clear it → empty state → fresh send
    // creates a new session. Drop the stuck queue so it doesn't replay into a dead thread.
    if (/thread not found|session not found|no thread attached/i.test(String(f.error || ""))) {
      pendingWsSends = [];
      try { localStorage.removeItem("t4a.sessionId"); } catch {}
      currentSessionId.value = null;
      threadAttached = false;
    }
  } else if (f.type === "open-setup") {
    // The server hit an unrecoverable model/config problem (e.g. the coder is offline
    // or misrouted) and is asking the user to fix it in Setup. Surface + open it.
    dropTrailingEmpty();
    push({ role: "tool", card: { name: "setup-needed", result: { ok: false, error: f.reason || "The model is unavailable — check your Thinker/Coder setup." } } });
    streaming.value = false;
    stopTurnClock();
    fetch("/api/model").then(r => r.json()).then(j => (modelInfo.value = j)).catch(() => {});
    settingsOpen.value = true;
  } else if (f.type === "debug") {
    // Machinery/trace events (scaffold, edits, retries, serve-gate, file writes) — the CONSOLE stream.
    // Collected always into a capped ring buffer so toggling the console ON shows recent history;
    // rendered only when the console is open (OFF by default — non-coders never see it).
    const ev = { event: f.event, detail: f.detail, at: Date.now() };
    const arr = debugEvents.value.concat(ev);
    debugEvents.value = arr.length > 500 ? arr.slice(arr.length - 500) : arr;
  }
}

// Plan links inside a chat message open the in-app plan viewer (one delegate for all messages,
// since the markdown is set via innerHTML and has no per-node handlers).
document.addEventListener("click", (e) => {
  const a = e.target && e.target.closest && e.target.closest("a.plan-link");
  if (!a) return;
  e.preventDefault();
  viewPlan(a.dataset.path || "plan/MASTER.md");
});

// Open the connection (auto-reconnects on drop).
connectWS();

// ------------------ model info ------------------
fetch("/api/model").then((r) => r.json()).then((j) => (modelInfo.value = j)).catch(() => {});
pfetch("/api/service").then((r) => r.json()).then((j) => { if (j?.service) service.value = j.service; }).catch(() => {});

// Stream a MANUALLY-run service's backend log into the Server tab. The agent's own builds already
// stream logs over WS (addServiceError); this covers the Run-button path, which has no WS actor. We
// only poll while `manualRunActive` so we don't double-log the agent's builds. `since` is a monotonic
// cursor the backend honours across its ring-buffer shift.
const manualRunActive = signal(false);
let _svcLogSince = 0;
setInterval(async () => {
  if (!manualRunActive.value || !service.value) return;
  try {
    const j = await pfetch(`/api/service/logs?since=${_svcLogSince}`).then((r) => r.json());
    if (!j?.running) { manualRunActive.value = false; return; }
    if (Array.isArray(j.lines) && j.lines.length) {
      const add = j.lines.map((line) => ({ event: /error|traceback|exception|failed|❌/i.test(line) ? "server:error" : "server:log", detail: String(line).slice(0, 1000), at: Date.now() }));
      debugEvents.value = [...debugEvents.value, ...add].slice(-500);
    }
    if (typeof j.total === "number") _svcLogSince = j.total;
  } catch {}
}, 1500);

function refreshTree() {
  pfetch("/api/tree").then((r) => r.json()).then((j) => (fileTree.value = j)).catch(() => {});
}
refreshTree();

// ------------------ helpers ------------------
// Forward a runtime error from the live preview up to the attached thread.
// De-duped + throttled so a render loop doesn't flood the agent.
const _seenPreviewErrs = new Set();
let _previewErrBurst = 0;
let _previewErrWindowAt = 0;
function reportPreviewError(err) {
  // Show it in the developer CONSOLE panel (the app's own runtime output) regardless of the ws state.
  const arr = debugEvents.value.concat({ event: `app:${err.kind}`, detail: err.message + (err.source ? ` (${String(err.source).split("/").pop()}:${err.line ?? "?"})` : ""), at: Date.now() });
  debugEvents.value = arr.length > 500 ? arr.slice(arr.length - 500) : arr;
  if (ws.readyState !== 1) return;
  const now = Date.now();
  if (now - _previewErrWindowAt > 3000) { _previewErrWindowAt = now; _previewErrBurst = 0; }
  if (_previewErrBurst >= 5) return;           // cap 5 per 3s
  const sig = `${err.kind}|${err.message}|${err.line ?? ""}`;
  if (_seenPreviewErrs.has(sig)) return;        // one report per distinct error
  _seenPreviewErrs.add(sig);
  _previewErrBurst++;
  ws.send(JSON.stringify({ type: "preview:error", error: err }));
}
// Console bridge: a cross-origin preview (the live backend on its own port) can't be instrumented
// directly, so served pages postMessage their console/errors to us. Show them in the console panel.
window.addEventListener("message", (e) => {
  const d = e.data;
  if (!d || d.__t4a !== "console") return;
  const arr = debugEvents.value.concat({ event: `app:${d.level || "log"}`, detail: String(d.text || "").slice(0, 500), at: Date.now() });
  debugEvents.value = arr.length > 500 ? arr.slice(arr.length - 500) : arr;
});

// ---- chat attachments (paste/drop images + text files) ----
const pendingAttachments = signal([]); // {id, kind:'image'|'file', name, mime, dataUrl?, text?, size}
let _attId = 0;
const IMG_MAX = 5 * 1024 * 1024;   // 5MB
const FILE_MAX = 200 * 1024;       // 200KB of text
const TEXT_EXT = /\.(txt|md|markdown|plan|csv|tsv|json|ya?ml|xml|html?|css|js|ts|jsx|tsx|py|rb|php|sql|log|sh|toml|ini|env|go|rs|java|c|cpp|h)$/i;
function classify(file) {
  const t = (file.type || "").toLowerCase();
  const n = (file.name || "").toLowerCase();
  if (t.startsWith("image/")) return "image";
  if (t.startsWith("text/") || t.includes("json") || t.includes("xml") || TEXT_EXT.test(n)) return "text";
  return "binary"; // pdf / xlsx / pptx / docx — need server-side extraction
}
function readAttachment(file) {
  return new Promise((resolve) => {
    const kind = classify(file);
    if (kind === "image" && file.size > IMG_MAX) { alert(`Image too large (${Math.round(file.size/1024)}KB, max 5MB)`); return resolve(null); }
    if (kind === "text" && file.size > FILE_MAX) { alert(`File too large (${Math.round(file.size/1024)}KB, max 200KB of text)`); return resolve(null); }
    const id = ++_attId;
    const DOC_MAX = 15 * 1024 * 1024; // 15MB for pdf/office
    if (kind === "binary") {
      if (file.size > DOC_MAX) { alert(`File too large (${Math.round(file.size/1024/1024)}MB, max 15MB)`); return resolve(null); }
      // PDF/Office: send base64 → the server extracts text (office) or passes the
      // PDF to the model as a document (Opus).
      const rr = new FileReader();
      rr.onload = () => resolve({ id, kind: "doc", name: file.name || "document", mime: file.type || "application/octet-stream", dataUrl: String(rr.result), size: file.size });
      rr.onerror = () => resolve(null);
      rr.readAsDataURL(file);
      return;
    }
    const r = new FileReader();
    r.onload = () => {
      if (kind === "image") resolve({ id, kind: "image", name: file.name || "pasted-image.png", mime: file.type || "image/png", dataUrl: String(r.result), size: file.size });
      else resolve({ id, kind: "file", name: file.name || "file.txt", mime: file.type || "text/plain", text: String(r.result), size: file.size });
    };
    r.onerror = () => resolve(null);
    if (kind === "image") r.readAsDataURL(file); else r.readAsText(file);
  });
}
async function addAttachments(files) {
  for (const f of files) {
    const a = await readAttachment(f);
    if (a) pendingAttachments.value = [...pendingAttachments.value, a];
  }
}
function removeAttachment(id) { pendingAttachments.value = pendingAttachments.value.filter((a) => a.id !== id); }

async function sendPrompt(text, midTurn = "steer") {
  const atts = pendingAttachments.value;
  if (!text && atts.length === 0) return;
  if (!text) text = atts.some(a => a.kind === "image") ? "(see attached image)" : "(see attached file)";
  if (streaming.value) {
    if (midTurn === "queue") {
      // explicit queue (⌘/Ctrl+Enter): run after the current turn completes
      promptQueue.value = [...promptQueue.value, text];
      push({ role: "user", content: text, queued: true, at: Date.now() });
      return;
    }
    // default mid-turn action: STEER now — inject into the running turn so the
    // agent picks it up at the next round boundary (see server addSteer). Carry any
    // attachments (e.g. a pasted reference image) so the server can describe + fold them.
    if (ws.readyState === 1) {
      ws.send(JSON.stringify({ type: "steer", content: text, attachments: atts }));
      push({ role: "user", content: text, steered: true, at: Date.now(), attachments: atts.length ? atts : undefined });
      think("ask", "steered: " + text.slice(0, 60));
    } else {
      // socket not open — fall back to queueing so the message isn't lost
      promptQueue.value = [...promptQueue.value, text];
      push({ role: "user", content: text, queued: true, at: Date.now(), attachments: atts.length ? atts : undefined });
    }
    if (atts.length) pendingAttachments.value = [];
    return;
  }
  // Lazy-create a session on first send, titled from the first line
  if (!currentSessionId.value) {
    const title = text.split("\n")[0].slice(0, 60);
    await createSession(title, title);
  }
  turnStats.value = null;
  push({ role: "user", content: text, at: Date.now(), attachments: atts.length ? atts : undefined });
  // Attachment-aware send: if the socket is mid-reconnect / not yet attached, this queues and
  // flushes on thread:attached — so a message during a restart never gets "no thread attached".
  wsSendWhenAttached({ type: "user", content: text, mode: agentMode.value, attachments: atts });
  if (atts.length) pendingAttachments.value = [];
}

// Turn auto-pilot on/off (server + UI in one place).
async function setAutoPilot(on) {
  try {
    await fetch("/api/model", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ autoPilot: !!on }) });
    modelInfo.value = { ...modelInfo.value, autoPilot: !!on };
  } catch {}
}
// Kick off a canned build from an on-screen action button. A one-click build is an explicit
// "go do this" — engage auto-pilot so it runs autonomously to completion instead of pausing to
// ask (which is what the empty-state cards used to do: start the build with auto-pilot OFF).
async function startBuildFromButton(prompt) {
  await setAutoPilot(true);
  sendPrompt(prompt);
}

// Open the current plan (plan/MASTER.md) in the file viewer — a quick jump from the build feed
// to the full plan without hunting through the file tree.
function viewPlan(planPath) {
  const path = typeof planPath === "string" && planPath ? planPath : "plan/MASTER.md";
  pfetch("/api/file?path=" + encodeURIComponent(path))
    .then((r) => r.json())
    .then((j) => { if (j && !j.error) viewingFile.value = j; else alert(j?.error || "No plan yet — the thinker hasn't written one."); })
    .catch(() => alert("Could not load the plan."));
}
// Copy a message's text to the clipboard (copy icon on every prompt / thread).
function copyMessageText(text, btn) {
  const s = String(text || "");
  const done = () => { if (btn) { const o = btn.textContent; btn.textContent = "✓"; setTimeout(() => { btn.textContent = o; }, 900); } };
  try { navigator.clipboard.writeText(s).then(done, done); }
  catch { try { const ta = document.createElement("textarea"); ta.value = s; document.body.appendChild(ta); ta.select(); document.execCommand("copy"); ta.remove(); done(); } catch {} }
}
// Reply to a message in-thread: quote it into the composer and focus. Sending while
// a turn is running STEERS the agent (sendPrompt's default), so a reply feeds steer.
function replyToMessage(m) {
  const ta = document.querySelector("composer-el textarea");
  if (!ta) return;
  const quoted = String(m.content || "").replace(/\r/g, "").split("\n").slice(0, 4).join("\n").slice(0, 240).trim();
  const who = m.role === "assistant" ? "agent" : "me";
  ta.value = `> (${who}) ${quoted.replace(/\n/g, "\n> ")}\n\n`;
  ta.style.height = "auto"; ta.style.height = Math.min(180, ta.scrollHeight) + "px";
  ta.focus();
  ta.selectionStart = ta.selectionEnd = ta.value.length;
}

function flushQueueIfIdle() {
  if (streaming.value) return;
  if (promptQueue.value.length === 0) return;
  const [next, ...rest] = promptQueue.value;
  promptQueue.value = rest;
  // find the queued message + un-queue it visually
  const arr = messages.value;
  for (let i = 0; i < arr.length; i++) {
    if (arr[i].role === "user" && arr[i].queued && arr[i].content === next) {
      messages.value = [...arr.slice(0, i), { ...arr[i], queued: false }, ...arr.slice(i + 1)];
      break;
    }
  }
  turnStats.value = null;
  ws.send(JSON.stringify({ type: "user", content: next }));
}
function diffLines(prev, next) {
  const a = (prev ?? "").split("\n"), b = (next ?? "").split("\n"), out = [];
  const max = Math.max(a.length, b.length);
  for (let i = 0; i < max; i++) {
    if (a[i] === undefined) out.push({ k: "add", t: b[i] });
    else if (b[i] === undefined) out.push({ k: "del", t: a[i] });
    else if (a[i] === b[i]) out.push({ k: "ctx", t: a[i] });
    else { out.push({ k: "del", t: a[i] }); out.push({ k: "add", t: b[i] }); }
  }
  return out;
}

// ------------------ icon set (inline SVG) ------------------
const svgWrap = (d, viewBox = "0 0 24 24", stroke = "currentColor") =>
  html`<svg viewBox=${viewBox} fill="none" stroke=${stroke} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%"><path d=${d}></path></svg>`;
