  openext:   () => svgWrap("M14 4h6v6M20 4l-8 8M18 14v4a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2h4"),
  cloud:     () => svgWrap("M8 18a5 5 0 110-10 6 6 0 0111.5 2.5A4 4 0 0119 18H8z"),
