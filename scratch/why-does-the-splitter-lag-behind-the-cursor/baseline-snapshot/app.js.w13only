// ------------------ session rail ------------------
function fmtRel(ms) {
  const d = Date.now() - ms;
  if (d < 60_000) return "now";
  if (d < 3600_000) return Math.floor(d / 60_000) + "m";
  if (d < 86400_000) return Math.floor(d / 3600_000) + "h";
  return Math.floor(d / 86400_000) + "d";
}

class SessionRail extends Tina4Element {
  static shadow = false;
  onMount() { loadProject(); loadSessions(); }
  render() {
    const grouped = () => {
      const g = { active: [], done: [], archived: [] };
      for (const s of sessions.value) (g[s.status] || g.active).push(s);
      return g;
    };
    const groupBlock = (label, items) =>
      items.length === 0 ? null : html`
        <div class="rail-group">
          <div class="rail-group-h">${label} <span class="rail-count">${items.length}</span></div>
          ${items.map((s) => html`
            <button class=${() => "rail-item " + (s.status === "done" ? "done " : "") + (currentSessionId.value === s.id ? "on" : "")}
              @click=${() => activateSession(s.id)}>
              <span class="rail-title">${s.status === "done" ? html`<span class="rail-tick">✓</span> ` : null}${s.title}</span>
              <span class="rail-meta">${fmtRel(s.updatedAt)}${s.subpath ? " · 📂" + s.subpath : ""}${s.goal ? " · " + s.goal.slice(0, 40) : ""}</span>
              ${s.status === "done" && s.outcome ? html`<span class="rail-outcome" title=${s.outcome}>${s.outcome}</span>` : null}
              <span class="rail-actions">
                <button class="rail-x" title="Rename" @click=${(e) => { e.stopPropagation(); const t = prompt("Rename session", s.title); if (t) updateSession(s.id, { title: t }); }}>rename</button>
                ${s.status !== "done"     ? html`<button class="rail-x" title="Mark done" @click=${(e) => { e.stopPropagation(); updateSession(s.id, { status: "done" }); }}>done</button>` : null}
                ${s.status !== "archived" ? html`<button class="rail-x" title="Archive" @click=${(e) => { e.stopPropagation(); updateSession(s.id, { status: "archived" }); }}>archive</button>` : null}
                ${s.status !== "active"   ? html`<button class="rail-x" title="Reactivate" @click=${(e) => { e.stopPropagation(); updateSession(s.id, { status: "active" }); }}>reopen</button>` : null}
                <button class="rail-x danger" title="Delete" @click=${(e) => { e.stopPropagation(); if (confirm("Delete '" + s.title + "'?")) deleteSessionById(s.id); }}>×</button>
              </span>
            </button>`)}
        </div>`;
    return html`
      <aside class="session-rail">
        <div class="rail-project">
          <div class="rail-project-name">${() => projectInfo.value.name || "no project"}</div>
          <div class="rail-project-mission" title=${() => projectInfo.value.mission || "Set a project mission in Settings — it's the north star for every session"}>
            ${() => projectInfo.value.mission || html`<em class="dim">no mission — click cog to set one</em>`}
          </div>
        </div>
        <div class="rail-new">
          <button class="btn tiny primary" @click=${() => {
            const t = prompt("New session — short title (e.g. 'wire the login form')");
            if (!t) return;
            const g = prompt("Session goal (one line, optional)", "") || "";
            const s = prompt("Target subfolder inside the project (blank = project root, e.g. 'frontend' or 'backend')", "") || "";
            createSession(t, g, s);
          }}>${() => ICONS.plus()} <span>new session</span></button>
        </div>
        <div class="rail-list">
          ${() => {
            const g = grouped();
            return (sessions.value.length === 0)
              ? html`<div class="rail-empty">no sessions yet — start typing below</div>`
              : html`${groupBlock("Active", g.active)}${groupBlock("Done", g.done)}${groupBlock("Archived", g.archived)}`;
          }}
        </div>
        <div class="rail-footer" title="tina4-simple-agent version">
          tina4-simple-agent ${() => "v" + (modelInfo.value.version || "…")}
        </div>
      </aside>`;
  }
}
customElements.define("session-rail", SessionRail);

// ------------------ components ------------------
// The robot is inlined rather than embedded with <object>. Its artwork shades itself with
// mix-blend-mode:multiply on 5 shapes, and multiply darkens against whatever is *behind* it —
// but an <object> is its own document, so there was nothing behind those shapes and they
// rendered as opaque white: a plate. Measured dark-theme, .thinking, 84x101 box — 72.2% of it
// near-white, mean rgb(201,215,245), against an rgb(22,23,26) surface. Inlined, the same file
// composites against the page: 10.5% pale, blue badge unchanged at 36.6%. <img> would not fix
// it — it isolates the same way. Only inlining puts the page behind the blend.
async function mountTina4Bot() {
  const host = document.querySelector(".tina4-bot");
  if (!host) return;
  try {
    // Sized by CSS: the file declares a viewBox and no width/height, so it fills the box.
    host.innerHTML = await (await fetch("/images/tina4-robot-avatar.svg")).text();
    // innerHTML parses <script> but never runs it, and in this file the animation IS a script:
    // one inline SVGator player, no SMIL and no @keyframes anywhere in the 92KB. Without this
    // the robot inlines correctly and then sits perfectly still. Re-create each script in its
    // own namespace — an HTML <script> spliced into an SVG subtree stays inert.
    for (const old of host.querySelectorAll("script")) {
      const el = document.createElementNS(old.namespaceURI, "script");
      for (const a of old.attributes) el.setAttributeNS(a.namespaceURI, a.name, a.value);
      el.textContent = old.textContent;
      old.replaceWith(el);
    }
  } catch { /* decoration only — never break the shell over it */ }
}

class AppRoot extends Tina4Element {
  static shadow = false;
  // Once. The class binding is a fine-grained effect that calls setAttribute on this same
  // element, so a streaming change never re-creates it and never touches these children.
  onMount() { mountTina4Bot(); }
  render() {
    return html`
      <div class="shell">
        <div class="topbar">
          <div class="top-left">
            <div class="brand"><span class="dot">t4</span><span>simple agent</span></div>
            <button class="project-pill" title="Switch or manage projects"
              @click=${() => { loadProjectsList(); projectPickerOpen.value = true; }}>
              ${() => {
                const cur = projectsList.value.current;
                const p = projectsList.value.projects.find(x => (typeof x === 'string' ? x : x.folder) === cur);
                return p ? (typeof p === 'string' ? p : (p.name || p.folder)) : (cur || "no project");
              }}
              <span class="pl-chevron">▾</span>
            </button>
            <button class="cog-btn" title="New project" @click=${() => (newProjectOpen.value = true)}>${() => ICONS.plus()}</button>
            <button class="cog-btn" title="Edit current project" @click=${() => { loadProject(); loadSecrets(); projectOpen.value = true; }}>${() => ICONS.cog()}</button>
            ${() => hasProject.value ? html`
            <div class="branch-wrap">
              <button class="branch-chip" title="Switch git branch"
                @click=${async () => { if (!branchMenuOpen.value) await loadBranches(); branchMenuOpen.value = !branchMenuOpen.value; }}>
                <span class="branch-glyph">⎇</span> ${() => branchInfo.value.current || "—"} <span class="pl-chevron">▾</span>
              </button>
              ${() => branchMenuOpen.value ? html`<div class="branch-menu">
                ${(branchInfo.value.branches || []).length === 0
                  ? html`<div class="branch-empty">${() => branchInfo.value.note || "no branches"}</div>`
                  : (branchInfo.value.branches || []).map(b => html`
                    <button class=${"branch-item" + (b === branchInfo.value.current ? " cur" : "")}
                      @click=${() => switchBranch(b)}>${b}${b === branchInfo.value.current ? " ✓" : ""}</button>`)}
                <button class="branch-item new" @click=${async () => { const n = prompt("New branch name:"); if (n && n.trim()) await switchBranch(n.trim(), "create"); }}>+ new branch…</button>
              </div>` : null}
            </div>` : null}
          </div>
          <div class="top-right">
            <button class="cog-btn" title=${() => sessionsRailOpen.value ? "Hide sessions" : "Show sessions"}
              @click=${() => (sessionsRailOpen.value = !sessionsRailOpen.value)}>${() => ICONS.panels()}</button>
            <button class=${() => "cog-btn " + (previewVisible.value ? "on" : "")}
              title=${() => previewVisible.value ? "Hide preview" : "Show preview"}
              @click=${() => { if (previewVisible.value) previewClosed.value = true; else { previewClosed.value = false; previewNonce.value = Date.now(); } }}
            >${() => ICONS.eye()}</button>
            <button class="cog-btn" title="Refresh preview"
              @click=${() => { previewClosed.value = false; previewNonce.value = Date.now(); refreshPreviewManifest(); }}
            >${() => ICONS.refresh()}</button>
            <button class="cog-btn" title=${() => fileTreeOpen.value ? "Hide files" : "Show files"}
              @click=${() => { fileTreeOpen.value = !fileTreeOpen.value; if (fileTreeOpen.value) refreshTree(); }}>${() => ICONS.list()}</button>
            <span class="session-stats" title=${() => {
              const c = cost.value; if (!c || !c.byVendor) return "Cumulative agent time and tokens this project";
              const rows = Object.entries(c.byVendor).map(([v, e]) => `${v}: ${fmtTokens(e.tokensIn)} in / ${fmtTokens(e.tokensOut)} out · ${fmtTime(e.ms)}`);
              return "Real usage this project (COST.md):\n" + rows.join("\n") + (c.total ? `\nTotal: ${fmtTokens((c.total.tokensIn||0)+(c.total.tokensOut||0))} tok` : "");
            }}>
              ${() => fmtTime(sessionElapsed.value + (streaming.value ? turnElapsed.value : 0))}
              ·
              ${() => { const c = cost.value; const t = c && c.total ? (c.total.tokensIn || 0) + (c.total.tokensOut || 0) : sessionTokens.value; return fmtTokens(t); }} tok
            </span>
            <button class="cog-btn" title="Settings" @click=${() => {
              draftProjectsRoot.value = modelInfo.value.projectsRoot || "";
              draftEndpoint.value = modelInfo.value.endpoint || "";
              draftModel.value = modelInfo.value.model || "";
              draftToken.value = "";
              draftWorkspace.value = modelInfo.value.workspace || "";
              draftMcpUrl.value = modelInfo.value.mcpUrl || "";
              draftMcpToken.value = "";
              const eng = modelInfo.value.engine || {};
              draftGwContext.value = eng.gwContext !== false;
              draftGwKeepRounds.value = eng.gwKeepRounds ?? 10;
              draftGwK.value = eng.gwK ?? 6;
              draftCache1h.value = !!eng.anthropicCache1h;
              const think = modelInfo.value.thinking || {};
              draftThinking.value = !!think.enabled;
              draftThinkingModel.value = think.model || "claude-opus-4-8";
              draftDelegateCap.value = think.delegateCap ?? 24;
              thinkingKeyAvailable.value = think.keyAvailable !== false;
              settingsOpen.value = true;
            }}>${() => ICONS.cog()}</button>
            <button class="cog-btn" @click=${cycleTheme}
              title=${() => "Theme: " + theme.value + " (OS-driven by default — click to override light/dark)"}>
              ${() => theme.value === "light" ? ICONS.sun() : theme.value === "dark" ? ICONS.moon() : ICONS.auto()}
            </button>
          </div>
        </div>
        ${() => settingsOpen.value ? html`<settings-modal></settings-modal>` : null}
        ${() => projectOpen.value ? html`<project-modal></project-modal>` : null}
        ${() => newProjectOpen.value ? html`<new-project-modal></new-project-modal>` : null}
        ${() => projectPickerOpen.value ? html`<project-picker-modal></project-picker-modal>` : null}
        <div class=${() => "main " + (sessionsRailOpen.value ? "rail " : "") + (previewVisible.value ? "split " : "") + (fileTreeOpen.value ? "files" : "")}
             style=${() => previewVisible.value ? `--preview-w:${previewWidth.value}px` : ""}>
          ${() => sessionsRailOpen.value ? html`<session-rail></session-rail>` : null}
          <div class="center-col">
            ${() => threads.value.length > 0 ? html`<thread-bar></thread-bar>` : null}
            <div class="scroll">
              ${() => hasStarted.value
                ? html`<chat-view></chat-view>`
                : html`<empty-state></empty-state>`}
            </div>
            <composer-el></composer-el>
          </div>
          ${() => previewVisible.value ? html`<preview-splitter></preview-splitter><preview-pane></preview-pane>` : null}
          ${() => fileTreeOpen.value ? html`<file-tree-pane></file-tree-pane>` : null}
        </div>
        ${() => viewingFile.value ? html`<file-viewer></file-viewer>` : null}
        <div class=${() => "tina4-bot" + (streaming.value ? " thinking" : "")}
             role="img" aria-label="tina4"></div>
      </div>`;
  }
}
customElements.define("app-root", AppRoot);

class EmptyState extends Tina4Element {
  static shadow = false;
  render() {
    const CARDS = [
      { key: "build",  ico: "build",   title: "Build a tina4-js calculator",
        prompt: "Build me a clean tina4-js calculator. Add, subtract, multiply, divide, clear, and equals. Nice typography." },
      { key: "explore", ico: "explore", title: "Explore and understand code",
        prompt: "List the files in the workspace and give me a two-line summary of what each one does." },
      { key: "review",  ico: "review",  title: "Review code and suggest changes",
        prompt: "Read every HTML/JS file in the workspace and suggest three concrete improvements." },
      { key: "fix",     ico: "fix",     title: "Fix issues and failures",
        prompt: "Read index.html and fix anything that would break in a real browser." },
      { key: "build",   ico: "build",   title: "Full-stack shop (backend + tina4-js)",
        prompt: "Build a shopping website that shows off a real backend working with a tina4-js frontend. Ask me which backend framework to use before you scaffold anything. Storefront: a product catalogue with images/prices, a cart (add/remove/adjust quantity), and a checkout that places an order. Admin area (separate section): manage products and stock levels, and view/fulfil incoming orders (change status). Back it with real backend API routes and a database — products, stock, orders persist server-side; stock decrements on checkout. Seed a handful of demo products so it looks alive. Put backend and frontend in their own folders with the root plan/ as the overview, and make it clean and modern." },
      { key: "explore", ico: "explore", title: "Sudoku game (Frond + high scores)",
        prompt: "Build a Sudoku game served by a Tina4 backend using Frond server-side rendering with embedded tina4-js for the interactive grid. Generate a solvable puzzle with a few difficulty levels, validate entries and flag conflicts, and time each game. Save high scores (fastest completion per difficulty) in the backend so they persist across sessions, and show a leaderboard. Ask me which backend framework to use before scaffolding. Keep the board crisp and the interactions snappy." },
    ];
    // The eight "you do it" techniques (techniques/CATALOG.md section A) — how to ask so the
    // tool builds good software. Shown as plain guidance for non-coders on the empty state.
    const HOWTO = [
      ["Describe the outcome", "Say what “done” looks like on screen — not how to code it."],
      ["One feature at a time", "Ask for the smallest useful thing first, then add to it."],
      ["Show, don’t spell out", "Paste a screenshot or point at an app you like — it reads images."],
      ["Name the things", "List what the app tracks (users, orders, cards). Those become the data."],
      ["Say the must-nots", "What should never happen — e.g. “never lose my edits.”"],
      ["Pick the kind of app", "Game, tool, dashboard, or backend. It picks the approach from that."],
      ["Approve the plan", "Read the plan and the screens — you never have to read code."],
      ["Correct once, early", "It restates what it heard before building. Fix a wrong guess now."],
    ];
    return html`
      <div class="empty">
        <div class="glyph">${() => ICONS.cloud()}</div>
        <h1>What should we build in <em>${() => modelInfo.value.model || "the workspace"}</em>?</h1>
        <div class="cards">
          ${CARDS.map((c) => html`
            <button class="card" @click=${() => startBuildFromButton(c.prompt)}>
              <span class="ico" style=${`color: var(--tool-${c.key === "build" ? "build" : c.key === "explore" ? "explore" : c.key === "review" ? "review" : "fix"})`}>${() => ICONS[c.ico]()}</span>
              <span class="title">${c.title}</span>
            </button>`)}
        </div>
        <details class="howto">
          <summary>How to ask for good software <span class="howto-tag">no coding needed</span></summary>
          <div class="howto-grid">
            ${HOWTO.map(([t, d], i) => html`
              <div class="howto-item">
                <span class="howto-n">${String(i + 1).padStart(2, "0")}</span>
                <div><b>${t}</b><span>${d}</span></div>
              </div>`)}
          </div>
        </details>
      </div>`;
  }
}
customElements.define("empty-state", EmptyState);

function renderToolCard(f, meta) {
  f = f ?? {};
  const name = f.name || "tool";
  const ok = f.result?.ok === true;
  const p = f.args?.path ?? (name === "get_skill" ? f.args?.name : Array.isArray(f.result?.result) ? "." : "");
  const timing = f.elapsedMs ? `${f.elapsedMs}ms` : "";
  const iconKey = { write_file: "write", read_file: "read", list_dir: "list", get_skill: "explore", error: "error" }[name] || "circle";
  const expanded = signal(false);
  const showFull = signal(false); // write_file diff: false = changed (+/−) lines only; true = whole file

  // stuck_code — the agent ran out of ideas and is showing the person where it thinks the problem is.
  // Collapsed by DEFAULT: the invitation and the pills are the whole answer for someone who does not
  // read code, and opening this is a choice. Inside, the suspect line is marked, the box is editable,
  // and "Use my version" sends it straight back.
  if (name === "stuck_code") {
    const r = f.result || {};
    if (!r.snippet) return null;
    const open = signal(false);
    const draft = signal(r.snippet);
    const sent = signal(false);
    const firstLine = Number(r.startLine) || 1;
    const suspect = Number(r.suspectLine) || 0;
    return html`<div class="stuck-card">
      <button class="stuck-toggle" @click=${() => (open.value = !open.value)}>
        ${() => open.value ? "▾" : "▸"} Show me the code${suspect ? ` — I think it's around line ${suspect}` : ""}
        <span class="stuck-file">${r.file || ""}</span>
      </button>
      ${() => !open.value ? null : html`<div class="stuck-body">
        <div class="stuck-hint">Have a look and see if anything seems wrong. You can change it right here — you don't need to know how to code to spot something odd. If nothing jumps out, just use the buttons below the chat instead.</div>
        <div class="stuck-lines">
          ${draft.value.split("\n").map((ln, i) => html`<div class=${"stuck-line" + (firstLine + i === suspect ? " suspect" : "")}><span class="stuck-no">${firstLine + i}</span><span class="stuck-txt">${ln || " "}</span></div>`)}
        </div>
        <textarea class="stuck-edit" spellcheck="false" .value=${draft.value}
          @input=${(e) => (draft.value = e.currentTarget.value)}></textarea>
        <div class="stuck-actions">
          <button class="btn tiny primary" .disabled=${() => sent.value} @click=${() => {
            sent.value = true;
            wsSendWhenAttached({ type: "stuck:edit", content: draft.value });
          }}>${() => sent.value ? "sent ✓" : "Use my version"}</button>
          <button class="btn tiny" @click=${() => { draft.value = r.snippet; }}>Undo my changes</button>
        </div>
      </div>`}
    </div>`;
  }

  // ask_user — the agent is asking the user something. Render it prominently in
  // the chat window with clickable answer buttons (an answer is a fresh turn).
  if (name === "ask_user") {
    const q = f.result?.result?.question || f.result?.question || "";
    const opts = f.result?.result?.options || f.result?.options || [];
    return html`<div class="ask-card">
      <div class="ask-head"><span class="ico">${() => ICONS.circle()}</span><span>Agent needs your input</span></div>
      <div class="ask-q">${q}</div>
      ${opts.length ? html`<div class="ask-opts">${opts.map((o) => html`
        <button class="btn tiny primary" @click=${() => sendPrompt(String(o))}>${o}</button>`)}</div>` : null}
      <div class="ask-hint">…or just type your own answer below</div>
    </div>`;
  }

  // ---- summary line: one-word count / range ----
  let summary = "";
  if (ok && name === "write_file") {
    const prev = f.result?.result?.previous;
    const next = f.args?.content ?? "";
    const rows = diffLines(prev, next);
    const added = rows.filter((r) => r.k === "add").length;
    const removed = rows.filter((r) => r.k === "del").length;
    const bytes = f.result?.result?.bytes ?? next.length;
    summary = prev === null || prev === undefined
      ? `created · ${next.split("\n").length} lines · ${bytes} B`
      : `${added ? "+" + added : ""}${added && removed ? " " : ""}${removed ? "−" + removed : ""}${!added && !removed ? "no change" : ""}`;
  } else if (ok && name === "read_file") {
    const t = f.result?.result?.content ?? "";
    summary = `${t.split("\n").length} lines · ${t.length} chars`;
  } else if (ok && name === "list_dir") {
    // list_dir now returns { path, missing, entries: [...] } — old shape was a bare array.
    const raw = f.result?.result;
    const rows = Array.isArray(raw) ? raw : (raw?.entries ?? []);
    const missing = raw?.missing === true;
    const dirs = rows.filter((r) => r.kind === "dir").length;
    const files = rows.length - dirs;
    summary = missing ? "path missing (empty result)" : `${rows.length} entries (${dirs} dir, ${files} file)`;
  } else if (ok && name === "get_skill") {
    const c = f.result?.result?.content ?? "";
    summary = `${c.split("\n").length} lines loaded`;
  } else if (!ok) {
    summary = "error";
  }

  // ---- expanded body ----
  const renderBody = () => {
    if (!expanded.value) return null;
    if (ok && name === "write_file") {
      const rows = diffLines(f.result?.result?.previous, f.args?.content);
      // Compute per-side line numbers (Claude-Code-style two-column gutter)
      let oldNo = 0, newNo = 0;
      const withNums = rows.map(r => {
        if (r.k === "add") { newNo++; return { ...r, ln: newNo, side: "add" }; }
        if (r.k === "del") { oldNo++; return { ...r, ln: oldNo, side: "del" }; }
        oldNo++; newNo++; return { ...r, ln: newNo, side: "ctx" };
      });
      const added = rows.filter(r => r.k === "add").length;
      const removed = rows.filter(r => r.k === "del").length;
      const ctxCount = withNums.length - added - removed;
      // DEFAULT: show only the changed (+/−) lines; unchanged context is hidden behind a toggle
      // (owner: "only see the + - lines by default with option to expand to full"). Non-adjacent
      // changes get a "⋯" divider so hidden gaps are visible. A freshly-created file (all adds, no
      // context) has nothing to hide, so the toggle is omitted there.
      const view = [];
      if (showFull.value) { for (const r of withNums) view.push({ r }); }
      else {
        let last = -2;
        withNums.forEach((r, i) => {
          if (r.side === "ctx") return;
          if (view.length && i > last + 1) view.push({ gap: true });
          view.push({ r }); last = i;
        });
      }
      return html`<div class="tool-body diff">
        ${() => ctxCount > 0 ? html`<div class="diff-toggle">
          <button class="btn tiny" @click=${() => { showFull.value = !showFull.value; }}>
            ${() => showFull.value ? `Show changes only (+${added} −${removed})` : `Show full file (${withNums.length} lines)`}
          </button>
        </div>` : null}
        <div class="diff-body">${() => view.map(x => x.gap
          ? html`<div class="diff-row gap"><span class="diff-ln"></span><span class="diff-sign">⋯</span><span class="diff-text"></span></div>`
          : html`<div class=${`diff-row ${x.r.side}`}>
            <span class="diff-ln">${x.r.ln}</span>
            <span class="diff-sign">${x.r.k === "add" ? "+" : x.r.k === "del" ? "−" : " "}</span>
            <span class="diff-text">${x.r.t ?? ""}</span>
          </div>`)}
        </div>
      </div>`;
    }
    if (ok && name === "read_file") {
      const t = f.result?.result?.content ?? "";
      const clipped = t.length > 4000 ? t.slice(0, 4000) + "\n… (truncated)" : t;
      return html`<div class="tool-body">${clipped}</div>`;
    }
    if (ok && name === "list_dir") {
      const raw = f.result?.result;
      const rows = Array.isArray(raw) ? raw : (raw?.entries ?? []);
      if (raw?.missing) return html`<div class="tool-body">(directory does not exist)</div>`;
      return html`<div class="tool-body">${rows.map((r) => html`<span class="line ctx">${(r.kind === "dir" ? "📁 " : "📄 ") + r.name}</span>`)}</div>`;
    }
    if (ok && name === "get_skill") {
      const c = f.result?.result?.content ?? "";
      const clipped = c.length > 4000 ? c.slice(0, 4000) + "\n… (truncated — full skill in memory)" : c;
      return html`<div class="tool-body">${clipped}</div>`;
    }
    if (!ok) return html`<div class="tool-body">${f.result?.error ?? "error"}</div>`;
    return null;
  };

  const cls = `tool-pill ${name === "get_skill" ? "muted" : ""} ${!ok ? "err" : ""}`;
  return html`
    <div class=${() => cls + (expanded.value ? " expanded" : "")}>
      <button class="pill-head" @click=${() => (expanded.value = !expanded.value)}>
        ${meta?.at ? html`<span class="tool-stamp" title=${new Date(meta.at).toLocaleString()}>${fmtStamp(meta.at)}</span>` : null}
        ${meta?.skills?.length ? html`<span class="skills-used tool-skills">${meta.skills.map((s) => html`<span class="skill-chip">${s}</span>`)}</span>` : null}
        <span class="ico">${() => ICONS[iconKey]()}</span>
        ${name === "write_file" ? null : html`<span class="name">${name}</span>`}
        ${p ? html`<span class="path">${p}</span>` : null}
        <span class="summary">${summary}</span>
        ${timing ? html`<span class="timing">${timing}</span>` : null}
        <span class="chev">${() => expanded.value ? "▾" : "▸"}</span>
      </button>
      ${() => renderBody()}
    </div>`;
}

function escapeHTML(s) {
  return String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
}

// Tiny inline markdown renderer for assistant messages.
// Escapes HTML first, then applies **bold**, `code`, and `- ` bullet lines.
function _mdInline(line) {
  return escapeHTML(line)
    .replace(/`([^`\n]+)`/g, '<code>$1</code>')                                  // `code`
    .replace(/&lt;code&gt;([\s\S]*?)&lt;\/code&gt;/g, '<code>$1</code>')          // model-emitted <code> tags
    .replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>')                        // **bold**
    // [text](url) — but a link to a file INSIDE the project (plan/MASTER.md, a .plan) opens the
    // in-app viewer instead of navigating, so the agent can drop "view plan" straight into a sentence.
    .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_m, text, url) => /^(plan\/|.*\.plan$)/i.test(url)
      ? `<a class="plan-link" data-path="${escapeHTML(url)}" title="Open the plan">${text}</a>`
      : `<a href="${url}" target="_blank" rel="noopener">${text}</a>`)
    .replace(/(^|[\s(])((?:https?:\/\/)[^\s<)]+)/g, '$1<a href="$2" target="_blank" rel="noopener">$2</a>'); // bare URL → clickable
}
function _splitRow(l) { return l.trim().replace(/^\|/, "").replace(/\|$/, "").split("|").map((c) => c.trim()); }
function renderInlineMd(s) {
  if (!String(s).trim()) return "";
  const lines = String(s).split("\n");
  const isSep = (l) => /^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)+\|?\s*$/.test(l);
  const isRow = (l) => l.trim().startsWith("|") && l.includes("|");
  const out = [];
  for (let i = 0; i < lines.length; i++) {
    // Fenced code block: ```lang … ``` → <pre><code>. Must come first so its
    // contents aren't treated as markdown (headings/bullets/tables inside code).
    const fence = lines[i].match(/^\s*```(\w*)\s*$/);
    if (fence) {
      const lang = fence[1] || "";
      const buf = [];
      i++;
      while (i < lines.length && !/^\s*```\s*$/.test(lines[i])) { buf.push(lines[i]); i++; }
      // i now points at the closing ``` (or end); the for-loop ++ skips it.
      out.push(`<pre class="md-code"${lang ? ` data-lang="${lang}"` : ""}><code>${escapeHTML(buf.join("\n"))}</code></pre>`);
      continue;
    }
    // GFM table: a "| … |" header row immediately followed by a "|---|---|" separator.
    if (isRow(lines[i]) && i + 1 < lines.length && isSep(lines[i + 1])) {
      const header = _splitRow(lines[i]);
      i += 2;
      const rows = [];
      while (i < lines.length && isRow(lines[i])) { rows.push(_splitRow(lines[i])); i++; }
      i--; // the for-loop will ++ past the last consumed row
      let t = '<table class="md-table"><thead><tr>' + header.map((h) => `<th>${_mdInline(h)}</th>`).join("") + "</tr></thead><tbody>";
      for (const r of rows) t += "<tr>" + r.map((c) => `<td>${_mdInline(c)}</td>`).join("") + "</tr>";
      out.push(t + "</tbody></table>");
      continue;
    }
    let line = lines[i];
    // ## / ### headings → styled heading line (was rendering as literal "## Foo").
    const h = line.match(/^(#{1,6})\s+(.*)$/);
    if (h) {
      let head = h[2];
      // Model sometimes crams "## Heading • item • item" onto one line — split the
      // bullets off so they render as a list under the heading.
      let bullets = [];
      if ((head.match(/\s•\s/g) || []).length >= 1) {
        const parts = head.split(/\s•\s/).map((p) => p.trim()).filter(Boolean);
        head = parts.shift() || "";
        bullets = parts;
      }
      out.push(`<div class="md-h md-h${h[1].length}">${_mdInline(head)}</div>`);
      for (const b of bullets) out.push(`<div class="md-li">${_mdInline(b)}</div>`);
      continue;
    }
    // A blob the model crammed onto one line with inline "•" separators → real bullets.
    if (!/^\s*[-*]\s/.test(line) && (line.match(/\s•\s/g) || []).length >= 2) {
      const parts = line.split(/\s•\s/).map((p) => p.trim().replace(/^•\s*/, "")).filter(Boolean);
      for (const p of parts) out.push(`<div class="md-li">${_mdInline(p)}</div>`);
      continue;
    }
    if (/^\s*[-*]\s+/.test(line)) { out.push(`<div class="md-li">${_mdInline(line.replace(/^\s*[-*]\s+/, ""))}</div>`); continue; }
    // Plain text line. Wrap in a block so line breaks survive `.content` white-space:normal
    // (bare "\n" would collapse). Blank lines become spacing between paragraphs.
    if (line.trim() === "") out.push('<div class="md-gap"></div>');
    else out.push(`<div class="md-p">${_mdInline(line)}</div>`);
  }
  return out.join("");
}

function fmtTime(ms) {
  if (!ms) return "";
  const s = Math.round(ms / 1000);
  return s < 60 ? `${s}s` : `${Math.floor(s / 60)}m ${String(s % 60).padStart(2, "0")}s`;
}
function fmtTokens(n) {
  n = n ?? 0;
  return n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
}

const TOOL_NAMES = new Set(["write_file", "read_file", "list_dir", "run_shell", "tina4_context"]);
function fmtStamp(t) {
  if (!t) return "";
  const d = new Date(t);
  return String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0");
}

function isJustToolNameEcho(text) {
  const t = (text ?? "").trim();
  if (!t) return false;
  // one word, matches a known tool name
  if (TOOL_NAMES.has(t)) return true;
  // "write_file(…)" or "call write_file" style
  const stripped = t.replace(/^(call|use|invoke)\s+/i, "").split(/[\s(]/)[0];
  return TOOL_NAMES.has(stripped);
}

function renderMessage(m) {
  m = m ?? {};
  if (m.role === "user") {
    const cancel = () => {
      promptQueue.value = promptQueue.value.filter((p) => p !== m.content);
      messages.value = messages.value.filter((x) => x !== m);
    };
    const commitEdit = (newText) => {
      const trimmed = String(newText ?? "").trim();
      if (!trimmed) { cancel(); return; }
      // replace in queue (first occurrence of old value)
      const q = [...promptQueue.value];
      const idx = q.indexOf(m.content);
      if (idx >= 0) q[idx] = trimmed;
      promptQueue.value = q;
      // replace in messages
      messages.value = messages.value.map((x) => x === m ? { ...x, content: trimmed } : x);
    };
    const steer = () => {
      // Send as steering; keep the message in the transcript as a delivered user bubble
      // (drop the queued flag so it renders normally, mark it as steered for the badge).
      if (streaming.value && ws.readyState === 1) {
        ws.send(JSON.stringify({ type: "steer", content: m.content }));
      }
      promptQueue.value = promptQueue.value.filter((p) => p !== m.content);
      messages.value = messages.value.map((x) => x === m ? { ...x, queued: false, steered: true, at: x.at || Date.now() } : x);
      think("ask", "steered: " + m.content.slice(0, 60));
    };
    const body = String(m.content ?? "").trim();
    const stampFullTitle = m.at ? new Date(m.at).toLocaleString() : "";
    if (m.queued) {
      return html`<div class="msg user queued">${m.at ? html`<div class="msg-stamp" title=${stampFullTitle}>${fmtStamp(m.at)}</div>` : null}<div class="content"><span class="editable" contenteditable="plaintext-only" spellcheck="false" @keydown=${(e) => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); e.currentTarget.blur(); } }} @blur=${(e) => commitEdit(e.currentTarget.textContent)}>${body}</span><button class="queue-wheel" title="Steer this into the current turn now" @click=${steer}>${() => ICONS.wheel()}</button><button class="queue-x" title="Remove from queue" @click=${cancel}>×</button></div><div class="queued-note">queued · steer to inject now · click text to edit</div></div>`;
    }
    const atts = m.attachments || [];
    return html`<div class=${"msg user" + (m.steered ? " steered" : "")}>${m.at ? html`<div class="msg-stamp" title=${stampFullTitle}>${fmtStamp(m.at)}${m.steered ? " · steered" : ""}</div>` : null}<div class="content">${body}${atts.length ? html`<div class="msg-attachments">${atts.map(a => a.kind === "image" ? html`<img class="msg-att-thumb" src=${a.dataUrl} alt=${a.name}>` : html`<span class="msg-att-file">📎 ${a.name}</span>`)}</div>` : null}</div><div class="msg-actions user"><button class="msg-act" title="Reply in thread (adds to steer)" @click=${() => replyToMessage(m)}>↩</button><button class="msg-act" title="Copy" @click=${(e) => copyMessageText(body, e.currentTarget)}>⧉</button></div></div>`;
  }
  if (m.role === "assistant") {
    if (isJustToolNameEcho(m.content)) return html``;
    const stats = m.stats;
    const skillsUsed = m.skills || [];
    const isLast = m === messages.value[messages.value.length - 1];
    return html`
      <div class="msg assistant">
        <div class="content">
          <div class="msg-meta">
            ${skillsUsed.length ? html`<span class="skills-used">${skillsUsed.map((s) => html`<span class="skill-chip">${s}</span>`)}</span>` : null}
            ${m.at ? html`<span class="msg-stamp inline" title=${new Date(m.at).toLocaleString()}>${fmtStamp(m.at)}</span>` : null}
            ${() => stats
              ? html`<span class="stats">${fmtTime(stats.elapsedMs)} · ${fmtTokens(stats.tokens)} tokens${stats.rounds > 1 ? ` · ${stats.rounds} rounds` : ""}</span>`
              : (isLast && streaming.value ? html`<span class="stats live">${fmtTime(turnElapsed.value)}</span>` : null)}
          </div>
          ${() => {
            const raw = String(m.content || "").trim();
            return raw ? html`<div class="md" .innerHTML=${renderInlineMd(raw)}></div>` : "";
          }}
          ${() => (isLast && streaming.value && !m.content)
            ? html`<div class="thinking-line"><span class="pulse"></span>${(thoughts.value[thoughts.value.length - 1]?.text) || "waiting for model…"}</div>`
            : null}
          ${() => String(m.content || "").trim() ? html`<div class="msg-actions">
            <button class="msg-act" title="Reply in thread (adds to steer)" @click=${() => replyToMessage(m)}>↩</button>
            <button class="msg-act" title="Copy" @click=${(e) => copyMessageText(m.content, e.currentTarget)}>⧉</button>
          </div>` : ""}
        </div>
      </div>`;
  }
  if (m.role === "done") {
    return html`<div class="msg done-banner">
      <span class="done-check">✔</span>
      <span class="done-text">${m.content}</span>
    </div>`;
  }
  if (m.role === "image") {
    return html`<div class="msg image-card">
      <img class="chat-image" src=${m.url} alt=${m.prompt || m.path || "generated image"} loading="lazy"
        @click=${() => { try { window.open(m.url, "_blank"); } catch {} }} title="Open full size">
      <div class="image-cap">🖼️ <span class="image-path">${m.path || "generated"}</span>${m.prompt ? html` — ${m.prompt}` : ""}</div>
    </div>`;
  }
  if (m.role === "files") {
    // Build manifest: short-name links (full path in the tooltip) + a copy-path icon each.
    const files = m.files || [];
    const base = (p) => (String(p).split("/").pop() || String(p));
    // Copy the ABSOLUTE path (workspace dir + relative path) so it pastes straight into a shell
    // or editor — the display stays the short name, but the copy/link yields the full path.
    const abs = (p) => {
      const s = String(p);
      if (s.startsWith("/")) return s;                       // already absolute
      const ws = String(modelInfo.value.workspace || "").replace(/\/+$/, "");
      return ws ? ws + "/" + s.replace(/^\/+/, "") : s;
    };
    const planPath = m.planPath || "plan/MASTER.md";
    // Lead with OUTCOMES (what each part does), not file names — a non-coder can't act on
    // `sudoku.py`. Light de-jargon of the plan's purpose text; raw file names live behind a
    // collapsed "technical details" toggle for when they're actually wanted.
    const friendly = (s) => {
      let t = String(s || "").trim();
      if (!t) return "A part of your app";
      t = t.replace(/^(the|a|an)\s+/i, "")
           .replace(/\btina4[-\w]*\s+/gi, "")
           .replace(/\bORM model (for|to)\b/i, "Store")
           .replace(/\bSQL migration to\b/i, "")
           .replace(/\bmigration (to|for)\b/i, "")
           .replace(/\broutes?\s+(for|to)\b/i, "")
           .replace(/\bentry that registers routes and handles?\b/i, "Set up")
           .replace(/\bregisters? routes( and handles?)?\b/i, "Set up")
           .replace(/\bcustom CSS( for the)?\b/i, "Style")
           .replace(/\s+/g, " ").trim();
      return t ? t[0].toUpperCase() + t.slice(1) : "A part of your app";
    };
    return html`<div class="msg files-card">
      <div class="files-head"><span class="files-icon">🛠️</span> ${m.label || "Building your app"}${() => isActivePlan(planPath) ? html`<span class="plan-active" title=${"Following the plan"}>● live</span>` : null}<button class="files-viewplan" title="See the full plan" @click=${() => viewPlan(planPath)}>view plan ↗</button></div>
      <ul class="build-steps">
        ${files.map((f) => {
          const purpose = typeof f === "string" ? "" : (f.purpose || "");
          const p = typeof f === "string" ? f : f.path;
          return html`<li class="build-step"><span class="step-dot">●</span> ${friendly(purpose || base(p))}</li>`;
        })}
      </ul>
      <details class="files-detail">
        <summary>Technical details · ${files.length} file${files.length === 1 ? "" : "s"}</summary>
        <ul class="files-list">
          ${files.map((f) => {
            const p = typeof f === "string" ? f : f.path;
            const purpose = typeof f === "string" ? "" : (f.purpose || "");
            return html`<li class="file-row">
              <a class="file-link" href="#" title=${() => abs(p)} @click=${(e) => { e.preventDefault(); copyMessageText(abs(p), e.currentTarget); }}>${base(p)}</a>
              ${purpose ? html`<span class="file-purpose">${purpose}</span>` : null}
              <button class="file-copy" title=${() => "Copy path: " + abs(p)} @click=${(e) => copyMessageText(abs(p), e.currentTarget)}>⧉</button>
            </li>`;
          })}
        </ul>
      </details>
    </div>`;
  }
  if (m.role === "tool") {
    const cls = "msg tool" + (m.stale ? " stale" : "") + (m.finished ? " finished" : "") + (m.collapsed ? " collapsed" : "");
    const skills = m.skills || [];
    // ONE line: time first, then the skill chip, then the file — the meta rides INSIDE the pill head
    // instead of sitting on its own row above it (owner). No layout/flex changes.
    return html`<div class=${cls}>
      ${renderToolCard(m.card, { at: m.at, skills })}
    </div>`;
  }
  return html``;
}

class ChatView extends Tina4Element {
  static shadow = false;
  onMount() {
    this._auto = effect(() => {
      const n = messages.value.length; void n;
      queueMicrotask(() => {
        const scroller = this.querySelector(".scroll") || this.closest(".scroll") || document.querySelector(".scroll");
        if (scroller) scroller.scrollTop = scroller.scrollHeight;
      });
    });
  }
  onUnmount() { this._auto && this._auto(); }
  render() {
    return html`<div class="messages">${() => messages.value.map(renderMessage)}</div>`;
  }
}
customElements.define("chat-view", ChatView);

// Default preview width = 38% of viewport, but never more than 520px, never less than 300px.
const _stored = Number(localStorage.getItem("t4a.previewWidth")) || 0;
const _default = Math.min(520, Math.max(300, Math.round(window.innerWidth * 0.38)));
const previewWidth = signal(_stored > 0 ? Math.min(_stored, window.innerWidth - 480) : _default);
effect(() => localStorage.setItem("t4a.previewWidth", String(previewWidth.value)));

const previewManifest = signal({ hasIndex: false, hasPackageJson: false, runCmd: null, port: null });
async function refreshPreviewManifest() {
  try { previewManifest.value = await pfetch("/api/workspace/manifest").then(r => r.json()); } catch {}
}
refreshPreviewManifest();
setInterval(refreshPreviewManifest, 4000);

// Auto-start the dev server when a runnable scaffold appears (Vite/TS frontend, etc.)
// so the preview renders instead of showing "waiting for the dev server". Once per
// project+cmd — a manual stop is respected (we don't re-spawn the same key).
const _autoRanServers = new Set();
effect(() => {
  const m = previewManifest.value;
  if (service.value || previewClosed.value) return;
  if (!m.runCmd || !m.port) return; // any runnable app (tina4 serve has no package.json)
  const key = (modelInfo.value.currentProject || "") + "|" + m.runCmd + "|" + m.port;
  if (_autoRanServers.has(key)) return;
  _autoRanServers.add(key);
  think("preview", `auto-starting dev server: ${m.runCmd} on :${m.port}`);
  fetch("/api/service/spawn", { method: "POST", headers: { "content-type": "application/json" },
    body: JSON.stringify({ cmd: m.runCmd, port: m.port }) }).catch(() => {});
});

class PreviewSplitter extends Tina4Element {
  static shadow = false;
  onMount() {
    this._down = (e) => {
      e.preventDefault();
      const startX = e.clientX;
      const startW = previewWidth.value;
      // Disable iframe pointer events during drag — otherwise the iframe
      // captures mousemove/mouseup and the drag freezes.
      const iframes = document.querySelectorAll("iframe.preview-frame");
      iframes.forEach(f => (f.style.pointerEvents = "none"));
      // Kill the grid-column transition so resize tracks the cursor 1:1
      const mainEl = document.querySelector(".main");
      const priorTransition = mainEl?.style.transition ?? "";
      if (mainEl) mainEl.style.transition = "none";
      const move = (m) => {
        const dx = startX - m.clientX;
        const w = Math.max(280, Math.min(window.innerWidth - 320, startW + dx));
        previewWidth.value = w;
      };
      const up = () => {
        document.removeEventListener("mousemove", move);
        document.removeEventListener("mouseup", up);
        document.body.style.cursor = "";
        document.body.style.userSelect = "";
        iframes.forEach(f => (f.style.pointerEvents = ""));
        if (mainEl) mainEl.style.transition = priorTransition;
      };
      document.addEventListener("mousemove", move);
      document.addEventListener("mouseup", up);
      document.body.style.cursor = "col-resize";
      document.body.style.userSelect = "none";
    };
    this.addEventListener("mousedown", this._down);
  }
  onUnmount() { this.removeEventListener("mousedown", this._down); }
  render() { return html`<div class="preview-splitter" title="Drag to resize preview"></div>`; }
}
customElements.define("preview-splitter", PreviewSplitter);

class PreviewPane extends Tina4Element {
  static shadow = false;
  onMount() {
    // Imperatively own the iframe so it NEVER gets recreated by template re-renders.
    // Only update .src when the computed URL actually changes to a NEW value.
    const iframeSlot = this.querySelector(".preview-frame-slot");
    if (!iframeSlot) return;
    const iframe = document.createElement("iframe");
    iframe.className = "preview-frame";
    iframe.setAttribute("sandbox", "allow-scripts allow-forms allow-same-origin");
    iframeSlot.appendChild(iframe);
    // After each load, for a SAME-ORIGIN preview (the static workspace/index.html)
    // inject runtime-error listeners so a broken build reports itself to the agent.
    // Cross-origin dev servers can't be instrumented — silently skipped.
    iframe.addEventListener("load", () => {
      _seenPreviewErrs.clear(); // fresh code — let re-introduced errors report again
      try {
        const win = iframe.contentWindow;
        if (!win) return;
        // Touch a same-origin property; throws for cross-origin → we skip.
        void win.location.href;
        if (win.__t4aErrHooked) return;
        win.__t4aErrHooked = true;
        const report = (kind, message, extra) => reportPreviewError({ kind, message, ...(extra || {}) });
        win.addEventListener("error", (e) => {
          report("error", e.message || String(e.error || "script error"),
            { source: e.filename, line: e.lineno, col: e.colno, stack: e.error?.stack?.slice(0, 800) });
        });
        win.addEventListener("unhandledrejection", (e) => {
          const r = e.reason;
          report("unhandledrejection", (r && (r.message || String(r))) || "unhandled promise rejection",
            { stack: r?.stack?.slice(0, 800) });
        });
        // Tee console.error/warn/log — the app's runtime output goes to the developer console panel.
        for (const level of ["error", "warn", "log", "info"]) {
          const orig = win.console[level].bind(win.console);
          win.console[level] = (...a) => { try { report("console." + level, a.map(String).join(" ")); } catch {} orig(...a); };
        }
      } catch { /* cross-origin — cannot instrument directly; the injected bridge postMessages instead */ }
    });
    let lastSrc = "";
    this._iframeEffect = effect(() => {
      const n = previewNonce.value || 1;
      const html = previewHtml.value || "index.html";
      let url = "about:blank";
      if (service.value) url = `${service.value.url}?t=${n}`;
      else if (html !== "index.html") url = `${wsBase()}/${html}?t=${n}`; // agent switched to a named page
      else if (previewManifest.value.hasIndex) url = `${wsBase()}/index.html?t=${n}`;
      if (url !== lastSrc) { iframe.src = url; lastSrc = url; }
    });
  }
  onUnmount() { this._iframeEffect?.(); }
  render() {
    const currentSrc = () => {
      const n = previewNonce.value || 1;
      const html = previewHtml.value || "index.html";
      if (service.value) return `${service.value.url}?t=${n}`;
      if (html !== "index.html") return `${wsBase()}/${html}?t=${n}`;
      if (previewManifest.value.hasIndex) return `${wsBase()}/index.html?t=${n}`;
      return "about:blank";
    };
    const stopApp = async () => {
      manualRunActive.value = false;
      await pfetch("/api/service/stop", { method: "POST" });
      // Immediately revert the pane to the static preview — don't wait for a WS
      // frame that may not come if the service already died.
      service.value = null;
      previewNonce.value = Date.now();
      previewClosed.value = false;
    };
    const runApp = async () => {
      const m = previewManifest.value;
      if (!m.runCmd || !m.port) return;
      think("run", `starting the app: ${m.runCmd}`);
      let r;
      try {
        r = await pfetch("/api/service/spawn", { method: "POST", headers: { "content-type": "application/json" },
          body: JSON.stringify({ cmd: m.runCmd, port: m.port }) }).then(r => r.json());
      } catch (e) { r = { ok: false, error: String(e) }; }
      if (r?.ok && r.service) {
        // Point the preview at the live service and reveal it.
        service.value = r.service;
        previewClosed.value = false;
        previewNonce.value = Date.now();
        _svcLogSince = 0; manualRunActive.value = true; // start streaming its backend log to the Server tab
        think("run", `running on :${r.service.port}`);
      } else {
        // Surface the FULL startup error in the Server tab (with a "+" to steer the agent), not a
        // truncated alert — this is the error the developer/LLM actually needs to fix it.
        const err = String(r?.error || "the app did not start");
        for (const line of err.split(/\r?\n/)) if (line.trim())
          debugEvents.value = [...debugEvents.value, { event: "server:error", detail: line, at: Date.now() }].slice(-500);
        consoleTab.value = "server";
        consoleOpen.value = true;
        think("run", "the app did not start — see the Server log");
      }
    };
    // A Vite/dev-server scaffold sits in the workspace but there's no live service.
    const needsRunner = computed(() =>
      !service.value && !!previewManifest.value.runCmd && !!previewManifest.value.port
    );
    return html`
      <div class="preview-col">
        <div class="preview-head">
          <span class="pill">
            <span class=${() => "status-dot " + (service.value || previewManifest.value.hasIndex ? "on" : "")}></span>
            ${() => service.value ? `service · :${service.value.port}`
                    : (previewHtml.value && previewHtml.value !== "index.html") ? `workspace/${previewHtml.value}`
                    : previewManifest.value.hasIndex ? "workspace/index.html"
                    : "no app yet"}
            ${() => service.value
              ? html`<button class="svc-toggle stop" title="Stop the service" @click=${stopApp}>■</button>`
              : (previewManifest.value.runCmd && previewManifest.value.port
                  ? html`<button class="svc-toggle play" title="Start the service" @click=${runApp}>▶</button>`
                  : null)}
          </span>
          <div class="actions">
            <button title="Pop out into standalone window" @click=${() => {
              const w = Math.min(900, screen.availWidth - 100), h = Math.min(1000, screen.availHeight - 100);
              window.open(currentSrc(), "t4a-preview", `popup=yes,width=${w},height=${h},resizable=yes`);
            }}>⧉</button>
            <button title="Open in new tab" @click=${() => window.open(currentSrc(), "_blank")}>${() => ICONS.openext()}</button>
            <button title="Reload" @click=${() => (previewNonce.value = Date.now())}>${() => ICONS.refresh()}</button>
            <button title="Close preview" @click=${() => (previewClosed.value = true)} class="close">×</button>
          </div>
        </div>
        <div class="preview-frame-slot"></div>
      </div>`;
  }
}
customElements.define("preview-pane", PreviewPane);

class FileTreePane extends Tina4Element {
  static shadow = false;
  render() {
    const openView = (p) => {
      pfetch("/api/file?path=" + encodeURIComponent(p))
        .then((r) => r.json())
        .then((j) => {
          if (j.error) return alert(j.error);
          viewingFile.value = j;
        });
    };
    const toggleDir = (p) => {
      expandedDirs.value = { ...expandedDirs.value, [p]: !expandedDirs.value[p] };
    };
    const renderNodes = (nodes, depth = 0) => nodes.map((n) => {
      if (n.kind === "dir") {
        const open = expandedDirs.value[n.path];
        return html`
          <div class=${"tree-row dir" + (n.skipped ? " skipped" : "")} style=${`padding-left:${depth * 12 + 8}px`}
            @click=${(e) => { e.stopPropagation(); if (!n.skipped) toggleDir(n.path); }}>
            <span class="tri">${n.skipped ? "·" : open ? "▾" : "▸"}</span>
            <span class="ico">${n.skipped ? "📁" : open ? "📂" : "📁"}</span>
            <span class="name">${n.name}${n.skipped ? " (skipped)" : ""}</span>
          </div>
          ${!n.skipped && open && n.children ? renderNodes(n.children, depth + 1) : null}`;
      }
      return html`
        <div class="tree-row file" style=${`padding-left:${depth * 12 + 8}px`}
          @click=${() => openView(n.path)}>
          <span class="tri"></span>
          <span class="ico">📄</span>
          <span class="name">${n.name}</span>
        </div>`;
    });
    return html`
      <div class="files-col">
        <div class="files-head">
          <span class="pill">workspace</span>
          <div class="actions">
            <button title="Reload" @click=${() => refreshTree()}>${() => ICONS.refresh()}</button>
          </div>
        </div>
        <div class="files-body">
          ${() => fileTree.value?.tree?.length
            ? renderNodes(fileTree.value.tree)
            : html`<div class="files-empty">no files yet</div>`}
        </div>
      </div>`;
  }
}
customElements.define("file-tree-pane", FileTreePane);

function htmlToMd(el) {
  // Walk a rendered contenteditable subtree and emit markdown.
  const out = [];
  const inline = (n) => {
    if (n.nodeType === 3) return n.textContent;
    if (n.nodeType !== 1) return "";
    const tag = n.tagName.toLowerCase();
    const inner = Array.from(n.childNodes).map(inline).join("");
    if (tag === "strong" || tag === "b") return `**${inner}**`;
    if (tag === "em" || tag === "i") return `*${inner}*`;
    if (tag === "del" || tag === "s")  return `~~${inner}~~`;
    if (tag === "code") return "`" + n.textContent + "`";
    if (tag === "a") return `[${inner}](${n.getAttribute("href") || ""})`;
    if (tag === "br") return "\n";
    return inner;
  };
  const block = (n, depth = 0) => {
    if (n.nodeType === 3) { const t = n.textContent.trim(); if (t) out.push(t); return; }
    if (n.nodeType !== 1) return;
    const tag = n.tagName.toLowerCase();
    if (/^h[1-6]$/.test(tag)) { out.push("#".repeat(+tag[1]) + " " + inline(n)); out.push(""); return; }
    if (tag === "p")           { out.push(inline(n)); out.push(""); return; }
    if (tag === "hr")          { out.push("---"); out.push(""); return; }
    if (tag === "blockquote")  { out.push("> " + inline(n).replace(/\n/g, "\n> ")); out.push(""); return; }
    if (tag === "pre")         { const code = n.querySelector("code")?.textContent ?? n.textContent; out.push("```\n" + code + "\n```"); out.push(""); return; }
    if (tag === "ul" || tag === "ol") {
      const marker = (i) => tag === "ol" ? `${i + 1}. ` : "- ";
      Array.from(n.children).forEach((li, i) => {
        if (li.tagName.toLowerCase() !== "li") return;
        const box = li.querySelector('input[type="checkbox"]');
        const prefix = " ".repeat(depth * 2) + marker(i) + (box ? (box.checked ? "[x] " : "[ ] ") : "");
        // grab inline text without nested lists
        const clone = li.cloneNode(true);
        clone.querySelectorAll("ul, ol").forEach(x => x.remove());
        out.push(prefix + inline(clone).trim());
        li.querySelectorAll(":scope > ul, :scope > ol").forEach(sub => block(sub, depth + 1));
      });
      out.push(""); return;
    }
    if (tag === "table") {
      const trs = Array.from(n.querySelectorAll("tr"));
      if (trs.length) {
        const cells = (tr) => Array.from(tr.querySelectorAll("th,td")).map((c) => inline(c).trim().replace(/\|/g, "\\|"));
        const head = cells(trs[0]);
        out.push("| " + head.join(" | ") + " |");
        out.push("| " + head.map(() => "---").join(" | ") + " |");
        for (let r = 1; r < trs.length; r++) out.push("| " + cells(trs[r]).join(" | ") + " |");
        out.push("");
      }
      return;
    }
    if (tag === "br") { out.push(""); return; }
    // fallback — treat as paragraph
    const t = inline(n).trim(); if (t) { out.push(t); out.push(""); }
  };
  Array.from(el.childNodes).forEach(n => block(n));
  return out.join("\n").replace(/\n{3,}/g, "\n\n").trim() + "\n";
}

function mdToHtml(src) {
  if (!src) return "";
  // Strip HTML comments from the RENDERED preview. Agent-maintained region markers like
  // `<!-- tina4:auto:start … -->` are meant to be invisible, but this renderer escapes '<' so they'd
  // show as literal text (owner: "I don't need to see markers in the .md preview"). Raw view keeps them.
  src = src.replace(/<!--[\s\S]*?-->/g, "");
  const esc = (s) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const inline = (s) => s
    .replace(/`([^`]+)`/g, (_, c) => `<code>${esc(c)}</code>`)
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, t, h) => `<a href="${esc(h)}" target="_blank" rel="noopener">${esc(t)}</a>`)
    .replace(/\*\*([^*]+)\*\*/g, (_, t) => `<strong>${t}</strong>`)
    .replace(/\*([^*]+)\*/g, (_, t) => `<em>${t}</em>`)
    .replace(/~~([^~]+)~~/g, (_, t) => `<del>${t}</del>`);
  const lines = src.replace(/\r\n?/g, "\n").split("\n");
  const out = [];
  let i = 0, inList = null, inCode = false, codeLang = "", codeBuf = [], codeIndent = 0, codeInList = false;
  const closeList = () => { if (inList) { out.push(`</${inList}>`); inList = null; } };
  const isTblRow = (l) => /^\s*\|.*\|\s*$/.test(l);
  const isTblSep = (l) => /^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)+\|?\s*$/.test(l);
  const splitTblRow = (l) => l.trim().replace(/^\|/, "").replace(/\|$/, "").split("|").map((c) => c.trim());
  while (i < lines.length) {
    const line = lines[i];
    // Fenced code block — allow LEADING WHITESPACE so a fence indented inside a
    // list item is still detected (the anchored /^```/ missed those, rendering the
    // ``` and the code literally AND splitting the surrounding <ol>).
    const fence = line.match(/^(\s*)```(\w+)?\s*$/);
    if (fence && !inCode) {
      inCode = true; codeLang = fence[2] || ""; codeIndent = fence[1].length; codeBuf = [];
      // An indented fence inside a list belongs to the current item — nest it there
      // and keep the list open so ordered numbering keeps counting.
      codeInList = !!inList && codeIndent > 0;
      if (!codeInList) closeList();
      i++; continue;
    }
    if (fence && inCode) {
      const block = `<pre class="code" data-lang="${esc(codeLang)}"><code>${esc(codeBuf.join("\n"))}</code></pre>`;
      if (codeInList && out.length && /<\/li>$/.test(out[out.length - 1])) {
        out[out.length - 1] = out[out.length - 1].replace(/<\/li>$/, block + "</li>");
      } else { out.push(block); }
      inCode = false; codeInList = false; i++; continue;
    }
    if (inCode) { codeBuf.push(codeIndent && line.startsWith(" ".repeat(codeIndent)) ? line.slice(codeIndent) : line); i++; continue; }
    // GFM table: a "| … |" header row immediately followed by a "|---|---|" separator.
    if (isTblRow(line) && i + 1 < lines.length && isTblSep(lines[i + 1])) {
      closeList();
      const header = splitTblRow(line);
      i += 2;
      const rows = [];
      while (i < lines.length && isTblRow(lines[i])) { rows.push(splitTblRow(lines[i])); i++; }
      let t = '<table class="md-table"><thead><tr>' + header.map((c) => `<th>${inline(esc(c))}</th>`).join("") + "</tr></thead><tbody>";
      for (const r of rows) t += "<tr>" + r.map((c) => `<td>${inline(esc(c))}</td>`).join("") + "</tr>";
      out.push(t + "</tbody></table>");
      continue;
    }
    if (/^\s*$/.test(line)) { closeList(); i++; continue; }
    const h = line.match(/^(#{1,6})\s+(.*)$/);
    if (h) { closeList(); out.push(`<h${h[1].length}>${inline(esc(h[2]))}</h${h[1].length}>`); i++; continue; }
    if (/^\s*[-*+]\s+/.test(line)) {
      if (inList !== "ul") { closeList(); out.push("<ul>"); inList = "ul"; }
      // Extract the checkbox marker BEFORE escaping so the label HTML never goes through esc()
      let rest = line.replace(/^\s*[-*+]\s+/, "");
      let taskHtml = "";
      const tm = rest.match(/^\[([ xX])\]\s+/);
      if (tm) {
        const checked = tm[1].trim() ? "checked" : "";
        // Not disabled — user can tick/untick in the WYSIWYG editor; htmlToMd
        // reads `.checked` on save. contenteditable="false" on the checkbox
        // itself keeps caret out of the checkbox but leaves clicks working.
        taskHtml = `<label class="task" contenteditable="false"><input type="checkbox" ${checked}> </label>`;
        rest = rest.slice(tm[0].length);
      }
      out.push(`<li>${taskHtml}${inline(esc(rest))}</li>`);
      i++; continue;
    }
    if (/^\s*\d+\.\s+/.test(line)) {
      if (inList !== "ol") { closeList(); out.push("<ol>"); inList = "ol"; }
      out.push(`<li>${inline(esc(line.replace(/^\s*\d+\.\s+/, "")))}</li>`);
      i++; continue;
    }
    if (/^\s{2,}·\s+|^\s{4,}/.test(line)) {
      // continuation lines of a list item — attach to previous
      const last = out.length - 1;
      if (last >= 0 && out[last].startsWith("<li>")) {
        out[last] = out[last].replace(/<\/li>$/, `<div class="li-sub">${inline(esc(line.trim().replace(/^·\s*/, "")))}</div></li>`);
      } else { out.push(`<p>${inline(esc(line))}</p>`); }
      i++; continue;
    }
    closeList();
    out.push(`<p>${inline(esc(line))}</p>`);
    i++;
  }
  closeList();
  if (inCode) out.push(`<pre class="code"><code>${esc(codeBuf.join("\n"))}</code></pre>`);
  return out.join("\n");
}

// ---------- zero-dependency syntax highlighting (no CDN, matches Tina4's ethos) ----------
const _esc = (s) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
// CodeMirror 5 mode for a file path (vendored modes: markdown/htmlmixed/css/python/xml/javascript).
function cmModeFor(lp) {
  lp = String(lp).toLowerCase();
  if (/\.(md|plan|markdown)$/.test(lp)) return "markdown";
  if (/\.html?$/.test(lp)) return "htmlmixed";
  if (/\.css$/.test(lp)) return "css";
  if (/\.py$/.test(lp)) return "python";
  if (/\.json$/.test(lp)) return { name: "javascript", json: true };
  if (/\.(ts|tsx)$/.test(lp)) return { name: "javascript", typescript: true };
  if (/\.(js|jsx|mjs|cjs)$/.test(lp)) return "javascript";
  if (/\.xml$/.test(lp)) return "xml";
  return null; // plain text
}
function langFromPath(p) {
  const e = (p.split(".").pop() || "").toLowerCase();
  return ({ py: "python", js: "js", mjs: "js", cjs: "js", ts: "js", tsx: "js", jsx: "js",
    rb: "ruby", php: "php", json: "json", css: "css", scss: "css", sh: "shell", bash: "shell",
    yml: "yaml", yaml: "yaml", html: "html", htm: "html", sql: "sql", go: "go", rs: "rust" })[e] || "";
}
const _KW = {
  python: "def class return if elif else for while in import from as pass break continue with try except finally raise lambda yield global nonlocal assert del not and or is async await self None True False",
  js: "function return if else for while do var let const new class extends super import export default from as typeof instanceof in of await async yield try catch finally throw switch case break continue this void delete null undefined true false",
  ruby: "def end class module return if elsif else unless while until for in do begin rescue ensure raise yield self require require_relative attr_accessor attr_reader attr_writer nil true false and or not then",
  php: "function return if else elseif for foreach while do class new extends implements interface public private protected static abstract final try catch finally throw namespace use as echo print instanceof null true false this",
  go: "func return if else for range var const type struct interface map chan go defer package import nil true false switch case break continue",
  rust: "fn return if else for while loop match let mut struct enum impl trait pub use mod crate self Some None Ok Err true false as ref move",
  sql: "SELECT FROM WHERE INSERT INTO VALUES UPDATE SET DELETE CREATE TABLE ALTER DROP JOIN LEFT RIGHT INNER OUTER ON GROUP BY ORDER LIMIT AND OR NOT NULL PRIMARY KEY FOREIGN REFERENCES DEFAULT",
};
// Highlight `code` into an ARRAY of per-line HTML strings. A token that spans lines
// (triple-quoted string, block comment) is split so each line's HTML is self-contained
// — so line numbers and per-line comments work without breaking multi-line coloring.
function highlightToLines(code, lang) {
  const kw = (_KW[lang] || "").split(/\s+/).filter(Boolean);
  const lines = [""];
  const emit = (cls, text) => {
    const segs = String(text).split("\n");
    segs.forEach((seg, i) => {
      if (i > 0) lines.push("");
      if (seg) lines[lines.length - 1] += cls ? `<span class="hl-${cls}">${_esc(seg)}</span>` : _esc(seg);
    });
  };
  if (!lang) { emit(null, code); return lines; } // unknown → plain (still line-split)
  const alts = [];
  if (lang === "python") alts.push('(?<s3>"""[\\s\\S]*?"""|\'\'\'[\\s\\S]*?\'\'\')');
  if (["js", "php", "css", "go", "rust", "sql"].includes(lang)) alts.push("(?<bc>/\\*[\\s\\S]*?\\*/)");
  const hash = ["python", "ruby", "shell", "yaml"].includes(lang);
  const slash = ["js", "php", "css", "go", "rust"].includes(lang);
  const dash = lang === "sql";
  const lc = [hash && "#[^\\n]*", slash && "//[^\\n]*", dash && "--[^\\n]*"].filter(Boolean).join("|");
  if (lc) alts.push("(?<lc>" + lc + ")");
  alts.push("(?<str>\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)");
  if (lang === "python") alts.push("(?<dec>@[A-Za-z_][\\w.]*)");
  if (lang === "php" || lang === "shell") alts.push("(?<var>\\$[A-Za-z_]\\w*)");
  alts.push("(?<num>\\b0[xX][0-9a-fA-F]+\\b|\\b\\d[\\d_]*(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b)");
  if (kw.length) alts.push("(?<kw>\\b(?:" + kw.join("|") + ")\\b)");
  alts.push("(?<fn>\\b[A-Za-z_]\\w*(?=\\s*\\())");
  const re = new RegExp(alts.join("|"), "g");
  let last = 0, m;
  while ((m = re.exec(code))) {
    if (m.index > last) emit(null, code.slice(last, m.index));
    const g = m.groups || {};
    const cls = g.s3 ? "str" : g.bc ? "com" : g.lc ? "com" : g.str ? "str"
      : g.dec ? "dec" : g.var ? "var" : g.num ? "num" : g.kw ? "kw" : g.fn ? "fn" : null;
    emit(cls, m[0]);
    last = m.index + m[0].length;
    if (m[0].length === 0) re.lastIndex++;
  }
  if (last < code.length) emit(null, code.slice(last));
  return lines;
}

// Line-level review comments for the currently-open code file. Sent to the plan as
// agent feedback. Reset each time a new file opens (see FileViewer.onMount).
const codeComments = signal([]); // [{ line, text }]
const codeEditMode = signal(false); // false = highlighted review view; true = raw edit
const mdRawView = signal(false); // for .md: false = rendered WYSIWYG, true = syntax-highlighted raw source
// Line-based markdown syntax highlighter — reuses the hl-* token classes the code highlighter uses,
// so the raw plan reads as coloured markdown (headings, list/checkbox markers, links, code, emphasis).
function mdHighlightLines(src) {
  let inFence = false;
  return String(src).split("\n").map((line) => {
    if (/^\s*```/.test(line)) { inFence = !inFence; return `<span class="hl-comment">${_esc(line)}</span>`; }
    if (inFence) return `<span class="hl-string">${_esc(line) || " "}</span>`;
    if (/^\s{0,3}#{1,6}\s/.test(line)) return `<span class="hl-keyword">${_esc(line)}</span>`;
    if (/^\s*>/.test(line)) return `<span class="hl-comment">${_esc(line) || " "}</span>`;
    let h = _esc(line);
    h = h.replace(/^(\s*(?:[-*+]|\d+\.)\s+)(\[[ xX]\]\s*)?/, (_m, mark, box) => `<span class="hl-decorator">${mark}</span>${box ? `<span class="hl-keyword">${box}</span>` : ""}`);
    h = h.replace(/`[^`]+`/g, (m) => `<span class="hl-string">${m}</span>`);
    h = h.replace(/(\*\*[^*]+\*\*|__[^_]+__)/g, (m) => `<span class="hl-number">${m}</span>`);
    h = h.replace(/(\[[^\]]+\])(\([^)]+\))/g, (_m, t, u) => `<span class="hl-keyword">${t}</span><span class="hl-string">${u}</span>`);
    return h || " ";
  });
}

class FileViewer extends Tina4Element {
  static shadow = false;
  onMount() {
    this._esc = (e) => { if (e.key === "Escape") viewingFile.value = null; };
    window.addEventListener("keydown", this._esc);
    // Reset per-file review state whenever a different file opens.
    let lastPath = null;
    this._resetEff = effect(() => {
      const f = viewingFile.value;
      if (f && f.path !== lastPath) { lastPath = f.path; codeComments.value = []; codeEditMode.value = false; mdRawView.value = false; }
    });
    // Mount CodeMirror in the raw/edit modes (a real editor with syntax highlighting). Recreates
    // when the file or mode changes; save() reads from this._cm when it's the active view.
    this._cmEff = effect(() => {
      const f = viewingFile.value || {}; const raw = mdRawView.value; const edit = codeEditMode.value; // deps
      queueMicrotask(() => {
        const host = this.querySelector(".cm-host");
        if (!host || typeof window.CodeMirror !== "function") { if (!host) this._cm = null; return; }
        const key = (f.path || "") + "|" + raw + "|" + edit;
        if (host._cmKey === key && this._cm) { this._cm.refresh(); return; }
        host.innerHTML = ""; this._cm = null;
        const dark = document.documentElement.getAttribute("data-theme") === "dark"
          || (!document.documentElement.getAttribute("data-theme") && matchMedia("(prefers-color-scheme: dark)").matches);
        this._cm = window.CodeMirror(host, {
          value: f.content || "", mode: cmModeFor(f.path || ""),
          lineNumbers: true, lineWrapping: true, viewportMargin: Infinity,
          theme: dark ? "material-darker" : "default", indentUnit: 2, tabSize: 2,
        });
        host._cmKey = key;
        setTimeout(() => { try { this._cm && this._cm.refresh(); } catch {} }, 30);
      });
    });
    // Populate the contentEditable box (md WYSIWYG or raw-edit) AFTER each render.
    // The read-only highlighted review view is rendered by render() itself.
    this._popEff = effect(() => {
      const f = viewingFile.value || {}; const edit = codeEditMode.value; // deps
      queueMicrotask(() => {
        const box = this.querySelector(".wysiwyg-edit");
        if (!box || box._filled === (f.path || "") + "|" + edit) return;
        const lpf = (f.path || "").toLowerCase();
        const isMd = lpf.endsWith(".md") || lpf.endsWith(".plan"); // .plan = markdown too — render it
        box.innerHTML = isMd ? mdToHtml(f.content || "")
          : "<pre>" + (f.content || "").replace(/[&<>]/g, s => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[s])) + "</pre>";
        box.contentEditable = "true";
        box._filled = (f.path || "") + "|" + edit;
        box.focus();
        // SUB-PLAN NAVIGATION — the master plan links to component sub-plans; make those links open
        // the sub-plan IN this viewer (a contentEditable box wouldn't navigate on its own). Resolve
        // the href relative to the current plan's folder so `backend/plan/MASTER.md` and `../x.md`
        // both work — every plan in the tree becomes followable.
        if (isMd) box.onclick = (ev) => {
          const a = ev.target?.closest?.("a"); if (!a) return;
          const href = a.getAttribute("href") || "";
          if (!/\.(md|plan)($|[?#])/i.test(href) || /^[a-z]+:\/\//i.test(href)) return; // only local .md/.plan links
          ev.preventDefault();
          const dir = (f.path || "").replace(/[^/]*$/, "");
          const joined = href.startsWith("/") ? href.slice(1) : dir + href;
          const norm = joined.split("/").reduce((acc, part) => {
            if (part === "..") acc.pop(); else if (part && part !== ".") acc.push(part);
            return acc;
          }, []).join("/");
          pfetch("/api/file?path=" + encodeURIComponent(norm)).then((r) => r.json())
            .then((j) => { if (j && !j.error) viewingFile.value = j; else alert(j?.error || ("Sub-plan not found: " + norm)); })
            .catch(() => alert("Could not open " + norm));
        };
      });
    });
  }
  onUnmount() { window.removeEventListener("keydown", this._esc); this._resetEff && this._resetEff(); this._popEff && this._popEff(); this._cmEff && this._cmEff(); this._cm = null; }
  // Imperatively open an inline comment input under a code line (avoids re-render focus loss).
  startComment(n, rowEl) {
    if (rowEl.nextElementSibling?.classList.contains("cl-input")) { rowEl.nextElementSibling.querySelector("input")?.focus(); return; }
    const div = document.createElement("div");
    div.className = "cl-input";
    div.innerHTML =
      `<input placeholder="Comment on line ${n} — Enter to add, Esc to cancel" />` +
      `<button class="cl-save" title="Add comment">Add</button>` +
      `<button class="cl-cancel" title="Cancel">Cancel</button>`;
    rowEl.after(div);
    const inp = div.querySelector("input"); inp.focus();
    const cancel = () => div.remove();
    const save = () => { const t = inp.value.trim(); if (t) codeComments.value = [...codeComments.value, { line: n, text: t }]; div.remove(); };
    inp.addEventListener("keydown", (ev) => {
      // Stop Esc/Enter from bubbling to the viewer's global Escape handler (which would
      // close the whole file view). Esc here cancels only the comment.
      if (ev.key === "Enter") { ev.preventDefault(); ev.stopPropagation(); save(); }
      else if (ev.key === "Escape") { ev.preventDefault(); ev.stopPropagation(); cancel(); }
    });
    div.querySelector(".cl-save").addEventListener("click", save);
    div.querySelector(".cl-cancel").addEventListener("click", cancel);
  }
  render() {
    const f = viewingFile.value || {};
    const lp = (f.path || "").toLowerCase();
    const isMd = lp.endsWith(".md") || lp.endsWith(".plan"); // .plan files are markdown-formatted followable plans
    // Anything else is edited as plain text — including .secrets/* files.
    const isText = !isMd && !/\.(png|jpg|jpeg|gif|webp|svg|ico|pdf|zip|tgz|gz|mp3|mp4|mov|woff2?|ttf|otf)$/i.test(lp);
    const focusBox = () => this.querySelector(".wysiwyg")?.focus();
    const exec = (cmd, arg = null) => (e) => { e.preventDefault(); document.execCommand(cmd, false, arg); focusBox(); };
    const wrapBlock = (tag) => (e) => { e.preventDefault(); document.execCommand("formatBlock", false, tag); focusBox(); };
    const save = async () => {
      // Prefer the CodeMirror editor when it's the active view (raw/edit mode); else the WYSIWYG box.
      let content;
      if (this._cm && this.querySelector(".cm-host")) content = this._cm.getValue();
      else {
        const box = this.querySelector(".wysiwyg");
        if (!box) return;
        content = isMd ? htmlToMd(box) : (box.innerText ?? "");
      }
      const r = await pfetch("/api/file", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ path: f.path, content }) }).then(r => r.json());
      if (!r?.ok) { alert("Save failed: " + (r?.error || "?")); return; }
      viewingFile.value = { ...f, content, size: r.size };
      refreshTree();
      return content;
    };
    // Plain Save on a file/plan: persist, then CLOSE the viewer (the user asked for save to close
    // it). saveAndContinue / sendCommentsToPlan keep their own close-after-action behaviour.
    const saveAndClose = async () => { const c = await save(); if (c != null) viewingFile.value = null; };
    const lang = isText ? langFromPath(lp) : "";
    // Send the line-level review comments into the plan as agent feedback.
    const sendCommentsToPlan = async () => {
      const comments = codeComments.value;
      if (!comments.length) return;
      const r = await fetch("/api/plan/feedback", { method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ path: f.path, comments }) }).then((r) => r.json()).catch(() => null);
      if (!r?.ok) { alert("Failed to send feedback: " + (r?.error || "?")); return; }
      const summary = comments.map((c) => `L${c.line}: ${String(c.text).replace(/\s+/g, " ").trim()}`).join("; ").slice(0, 500);
      codeComments.value = [];
      viewingFile.value = null;
      // Don't just LOG the comments — start a turn so the agent APPLIES them now (it was only
      // steering an already-running build, so nothing happened when none was running).
      const instr = `Apply my code-review comments on \`${f.path}\` — fix each referenced line, then tick it in the plan's ## Review Feedback. Comments: ${summary}`;
      push({ role: "user", content: instr, at: Date.now() });
      wsSendWhenAttached({ type: "user", content: instr, mode: agentMode.value });
    };
    // Decision mode: save the edited plan, then resume the agent with the user's answer.
    const saveAndContinue = async () => {
      const content = await save();
      if (content == null) return;
      const d = f.decision;
      // Hand the edited plan + the specific decision back to the agent as its next message.
      const resume = ws.readyState === 1;
      if (resume) {
        ws.send(JSON.stringify({
          type: "user",
          mode: agentMode.value,
          content:
            `I've made my decision in ${d.planPath} under ## Decisions` +
            (d.question ? ` (Q: ${d.question})` : "") +
            `. Read my ticked choice / notes below, then FIRST amend plan/MASTER.md to reflect it ` +
            `(turn the decision into concrete Steps/Tests — add, edit, or remove steps as needed and mark the decision resolved), ` +
            `THEN build. Current plan file:\n\n` +
            "```markdown\n" + content.slice(0, 12000) + "\n```",
        }));
        push({ role: "user", content: `Decision made in ${d.planPath} — continuing.`, at: Date.now() });
      }
      viewingFile.value = null;
    };
    return html`
      <div class="modal-backdrop" @click=${(e) => { if (e.target === e.currentTarget) viewingFile.value = null; }}>
        <div class="modal viewer">
          <div class="modal-head">
            <h3 title=${f.path}>${f.path}</h3>
            ${() => isActivePlan(f.path) ? html`<span class="plan-active" title="The agent is currently following this plan">● active plan</span>` : null}
            <button class="modal-close" @click=${() => (viewingFile.value = null)}>×</button>
          </div>
          ${isMd ? html`
            <div class="md-toolbar">
              <button title="Heading 1" @mousedown=${wrapBlock("h1")}>H1</button>
              <button title="Heading 2" @mousedown=${wrapBlock("h2")}>H2</button>
              <button title="Heading 3" @mousedown=${wrapBlock("h3")}>H3</button>
              <button title="Paragraph" @mousedown=${wrapBlock("p")}>&para;</button>
              <span class="sep"></span>
              <button title="Bold (Cmd/Ctrl+B)" @mousedown=${exec("bold")}><b>B</b></button>
              <button title="Italic (Cmd/Ctrl+I)" @mousedown=${exec("italic")}><i>I</i></button>
              <button title="Strikethrough" @mousedown=${exec("strikeThrough")}><del>S</del></button>
              <button title="Inline code" @mousedown=${(e) => { e.preventDefault(); const sel = window.getSelection().toString() || "code"; document.execCommand("insertHTML", false, "<code>"+sel+"</code>"); focusBox(); }}>&lt;/&gt;</button>
              <span class="sep"></span>
              <button title="Bulleted list" @mousedown=${exec("insertUnorderedList")}>&bull;</button>
              <button title="Numbered list" @mousedown=${exec("insertOrderedList")}>1.</button>
              <button title="Blockquote" @mousedown=${wrapBlock("blockquote")}>&#10077;</button>
              <span class="sep"></span>
              <button title="Link" @mousedown=${(e) => { e.preventDefault(); const url = prompt("Link URL"); if (url) document.execCommand("createLink", false, url); focusBox(); }}>&#128279;</button>
            </div>
          ` : null}
          <div class="viewer-body">
            ${() => (isMd && mdRawView.value) ? html`<div class="cm-host"></div>`
              : isMd ? html`<div class="wysiwyg wysiwyg-edit md-render" spellcheck="false"></div>`
              : (isText && codeEditMode.value) ? html`<div class="cm-host"></div>`
              : isText ? (() => {
                  const hlLines = highlightToLines(f.content || "", lang);
                  const byLine = {};
                  for (const c of codeComments.value) (byLine[c.line] ||= []).push(c);
                  return html`<div class="code-review">${hlLines.map((h, idx) => {
                    const n = idx + 1;
                    return html`
                      <div class="cl" data-line=${n}>
                        <span class="cl-num">${n}</span>
                        <code class="cl-code" .innerHTML=${h || " "}></code>
                        <button class="cl-add" title=${"Comment on line " + n} @click=${(e) => this.startComment(n, e.currentTarget.closest(".cl"))}>+</button>
                      </div>
                      ${(byLine[n] || []).map((c) => html`<div class="cl-note"><span class="cl-note-tag">L${n}</span><span class="cl-note-text">${c.text}</span><button class="cl-del" title="Remove" @click=${() => { codeComments.value = codeComments.value.filter((x) => x !== c); }}>×</button></div>`)}`;
                  })}</div>`;
                })()
              : html`<div class="viewer-binary">binary file — view only</div>`}
          </div>
          <div class="modal-actions">
            <span class="hint">${() => {
              if (f.decision) return html`<strong>Decision:</strong> ${f.decision.question || "tick your choice below, then Save & Continue"}`;
              const nc = codeComments.value.length;
              const kind = isMd ? "markdown" : isText ? (lang || "plain text") : "binary (view only)";
              return html`${f.size ?? 0} B &middot; ${kind}${nc ? ` · ${nc} comment${nc > 1 ? "s" : ""}` : ""}`;
            }}</span>
            <span class="spacer"></span>
            ${(isMd && !f.decision) ? html`<button class="btn ghost" @click=${() => (mdRawView.value = !mdRawView.value)} title="Toggle rendered vs syntax-highlighted raw markdown">${() => mdRawView.value ? "Rendered" : "Raw"}</button>` : null}
            ${(isText && !f.decision) ? html`<button class="btn ghost" @click=${() => (codeEditMode.value = !codeEditMode.value)} title="Toggle syntax-highlighted review vs raw editing">${() => codeEditMode.value ? "Review" : "Edit raw"}</button>` : null}
            ${(isText && !f.decision) ? html`<button class="btn primary" ?disabled=${() => codeEditMode.value || !codeComments.value.length} @click=${sendCommentsToPlan} title="Add these line comments to the plan as agent feedback">${() => "Send " + (codeComments.value.length ? codeComments.value.length + " " : "") + "to plan"}</button>` : null}
            <button class="btn ghost" @click=${() => (viewingFile.value = null)}>Cancel</button>
            ${f.decision
              ? html`<button class="btn primary" @click=${saveAndContinue}>Save &amp; Continue</button>`
              : isMd ? html`<button class="btn primary" @click=${saveAndClose}>Save</button>`
              : html`${() => (isText && codeEditMode.value) ? html`<button class="btn primary" @click=${saveAndClose}>Save</button>` : null}`}
          </div>
        </div>
      </div>`;
  }
}
customElements.define("file-viewer", FileViewer);

class ComposerEl extends Tina4Element {
  static shadow = false;
  onMount() {
    const seen = new Map(); // id -> DOM element
    this._cloudEff = effect(() => {
      const list = thoughts.value;
      const lane = this.querySelector(".cloud-lane");
      if (!lane) return;
      const currentIds = new Set(list.map(t => t.id));
      // remove clouds no longer in the list
      for (const [id, el] of seen) {
        if (!currentIds.has(id)) {
          el.remove();
          seen.delete(id);
        }
      }
      // Add new clouds AND (re)position existing ones so each has its own slot.
      const laneW = lane.offsetWidth || 600;
      const slotSpacing = 110; // px between cloud origins — allows slight edge overlap
      const cloudLeftOffset = 40; // nudge clear of the robot; tails still point at it
      const yStagger = [0, 22, 8, 28, 14, 32, 4, 18]; // vary vertical to avoid full occlusion
      list.forEach((t, i) => {
        let el = seen.get(t.id);
        const isNew = !el;
        if (isNew) {
          el = document.createElement("div");
          el.className = "thought-cloud " + t.kind;
          el.dataset.id = String(t.id);
          // Size to text volume — short thoughts get a small cloud, long ones sprawl.
          const len = t.text.length;
          const w = Math.round(Math.min(360, Math.max(140, 140 + len * 1.6)) * t.scale);
          const h = Math.round(Math.min(260, Math.max(120, 110 + len * 0.9)) * t.scale);
          el.style.width  = `${w}px`;
          el.style.height = `${h}px`;
          el.style.setProperty("--cloud-scale", String(t.scale));
        }
        // Slot: newest at i=0 (leftmost), older step right.
        el.style.left = `${cloudLeftOffset + i * slotSpacing}px`;
        el.style.bottom = `${yStagger[i % yStagger.length]}px`;
        el.style.zIndex = String(t.id); // newest on top
        if (isNew) {
          el.innerHTML = `
            <svg viewBox="0 0 160 160" preserveAspectRatio="none" class="cloud-shape">
              <path d="M 30 60 C 8 58, 8 34, 30 32 C 22 12, 52 8, 62 22 C 68 6, 98 4, 110 20 C 128 10, 150 30, 134 46 C 152 50, 152 72, 134 78 C 148 92, 130 108, 114 100 C 112 118, 82 122, 72 108 C 62 122, 32 118, 30 100 C 12 106, -2 84, 14 74 C -2 70, 6 48, 30 60 Z"
                fill="var(--surface)" stroke="var(--rule-strong)" stroke-width="1.6" stroke-linejoin="round"/>
              <circle cx="36" cy="128" r="6" fill="var(--surface)" stroke="var(--rule-strong)" stroke-width="1.4"/>
              <circle cx="24" cy="142" r="4" fill="var(--surface)" stroke="var(--rule-strong)" stroke-width="1.2"/>
              <circle cx="16" cy="152" r="2.5" fill="var(--surface)" stroke="var(--rule-strong)" stroke-width="1"/>
            </svg>
            <div class="cloud-inner" style="font-size:${11 * t.scale}px">${escapeHTML(t.text)}</div>`;
          lane.appendChild(el);
          seen.set(t.id, el);
        }
      });
    });
  }
  onUnmount() { this._cloudEff && this._cloudEff(); }
  render() {
    const submit = (e, midTurn = "steer") => {
      e && e.preventDefault();
      if (!hasProject.value) { newProjectOpen.value = true; return; }
      const ta = this.querySelector("textarea");
      const t = ta.value.trim();
      if (!t) return;
      pendingChoices.value = []; // typing an answer dismisses the quick-pick pills
      sendPrompt(t, midTurn);
      ta.value = "";
      ta.style.height = "auto";
    };
    const grow = (e) => {
      const ta = e.currentTarget;
      ta.style.height = "auto";
      ta.style.height = Math.min(180, ta.scrollHeight) + "px";
    };
    const onPaste = (e) => {
      const cd = e.clipboardData; if (!cd) return;
      const files = [...(cd.items || [])].filter(i => i.kind === "file").map(i => i.getAsFile()).filter(Boolean);
      if (files.length) { e.preventDefault(); addAttachments(files); return; }
      // Big text/code paste → make it a collapsible "pasted" attachment instead of
      // flooding the composer. Small pastes fall through to the normal textarea paste.
      const text = cd.getData("text/plain") || "";
      if (text.length > 2000 || text.split("\n").length > 30) {
        e.preventDefault();
        const id = ++_attId;
        const lines = text.split("\n").length;
        pendingAttachments.value = [...pendingAttachments.value, { id, kind: "file", name: `pasted (${lines} lines)`, mime: "text/plain", text, size: text.length }];
      }
    };
    const onDrop = (e) => { e.preventDefault(); const fs = [...(e.dataTransfer?.files || [])]; if (fs.length) addAttachments(fs); };
    return html`
      <div class="composer-wrap" @drop=${onDrop} @dragover=${(e) => e.preventDefault()}>
        <div class="cloud-lane" ref="lane"></div>
        ${() => pendingChoices.value.length ? html`<div class="choice-pills">
          ${pendingChoices.value.map((c) => html`<button type="button" class="choice-pill" @click=${() => { pendingChoices.value = []; sendPrompt(String(c)); }}>${c}</button>`)}
        </div>` : null}
        ${() => pendingAttachments.value.length ? html`<div class="attach-row">
          ${pendingAttachments.value.map(a => html`<div class="attach-chip" title=${a.name}>
            ${a.kind === "image"
              ? html`<img class="attach-thumb" src=${a.dataUrl} alt=${a.name}>`
              : html`<span class="attach-ico">${() => ICONS.read()}</span>`}
            <span class="attach-name">${a.name.length > 22 ? a.name.slice(0, 20) + "…" : a.name}</span>
            <button class="attach-x" @click=${() => removeAttachment(a.id)}>×</button>
          </div>`)}
        </div>` : null}
        ${() => activity.value ? html`<div class="agent-feed" title="Live feed from the delegated vendor client"><span class="feed-pulse"></span>${activity.value}</div>` : null}
        <form class="composer" @submit=${submit}>

          <div class="row1">
            <button type="button" class="attach-btn" title="Attach image or file"
              .disabled=${() => !hasProject.value}
              @click=${() => this.querySelector("input.att-input")?.click()}>${() => ICONS.plus()}</button>
            <input class="att-input" type="file" multiple style="display:none"
              accept="image/*,.txt,.md,.markdown,.csv,.tsv,.json,.yaml,.yml,.xml,.html,.css,.js,.ts,.py,.rb,.php,.sql,.log,.pdf,.xlsx,.xls,.pptx,.docx"
              @change=${(e) => { addAttachments([...e.target.files]); e.target.value = ""; }}>
            <textarea rows="1"
              .disabled=${() => !hasProject.value}
              placeholder=${() => !hasProject.value ? "Create a project first — top-left + button" : streaming.value ? "Steer the agent now — Enter to inject · ⌘⏎ to queue for after" : hasStarted.value ? "Reply to the agent…" : "Ask the agent to build something…"}
              @input=${grow}
              @paste=${onPaste}
              @keydown=${(e) => { if (e.key === "Enter" && !e.shiftKey) submit(e, (e.metaKey || e.ctrlKey) ? "queue" : "steer"); }}></textarea>
            <button class=${() => "send-btn" + (streaming.value ? " stopping" : "")} type=${() => streaming.value ? "button" : "submit"}
              @click=${() => {
                if (streaming.value) {
                  // Cancel the turn on the SERVER (aborts the in-flight model call +
                  // breaks the agent loop). Keep the socket — no reload needed.
                  try { if (ws && ws.readyState === 1) ws.send(JSON.stringify({ type: "stop" })); } catch {}
                  streaming.value = false;
                  stopTurnClock();
                  think("err", "stopping…");
                  dropTrailingEmpty();
                }
              }}
              title=${() => streaming.value ? "Stop the current turn" : "Send"}>
              ${() => streaming.value ? html`<span class="stop-glyph">■</span>` : ICONS.send()}
            </button>
          </div>
          <div class="row2">
            <div class="mode-switch" title="How the agent works this turn">
              ${["quick", "efficient", "meticulous"].map(m => html`
                <button
                  class=${() => "mode-btn " + (agentMode.value === m ? "on" : "")}
                  title=${m === "quick" ? "Get it done, minimal ceremony (skill rules still apply)"
                        : m === "efficient" ? "Plan + execute, balanced (default sweet spot)"
                        : "Meticulous — every skill rule, every test, full validation"}
                  @click=${() => (agentMode.value = m)}
                >${m}</button>
              `)}
            </div>
            <div class="row2-right">
            <button type="button" class=${() => "console-btn" + (consoleOpen.value ? " on" : "")}
              title="Developer console — the technical build log (scaffold, edits, retries, file writes). Off by default."
              @click=${(e) => { e.preventDefault(); consoleOpen.value = !consoleOpen.value; }}
            >${() => (consoleOpen.value ? "▣ console" : "▢ console")}</button>
            <button type="button" class=${() => "autopilot-btn" + (modelInfo.value.autoPilot ? " on" : "")}
              title="Auto-pilot: never ask, decide automatically, and build until the whole plan is complete"
              @click=${async (e) => {
                e.preventDefault();
                const next = !modelInfo.value.autoPilot;
                await fetch("/api/model", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ autoPilot: next }) });
                modelInfo.value = await fetch("/api/model").then(r => r.json());
                // If a turn is running, make the agent AWARE the mode changed so it
                // adapts immediately — resume interactive checkpoints when OFF, stop
                // asking when ON — rather than finishing the turn under the old mode.
                if (streaming.value && ws.readyState === 1) {
                  ws.send(JSON.stringify({ type: "steer", content: next
                    ? "[[tina4:internal]] auto-pilot was just turned ON — stop asking; decide everything yourself and drive the plan to completion."
                    : "[[tina4:internal]] auto-pilot was just turned OFF — you can interact with me again; pause at sensible checkpoints and ask/decide_in_plan when a real choice comes up." }));
                }
              }}>${() => (modelInfo.value.autoPilot ? "● auto-pilot ON" : "○ auto-pilot off")}</button>
            ${() => modelInfo.value.preset === "opus" && modelInfo.value.anthropicKeyAvailable === false
              ? html`<span class="model-warn" title="No Anthropic key found — this build has no key baked in and none is configured. Switch to tina4-coder or add a key in Settings.">⚠ no key</span>`
              : null}
            <span class=${() => "status-dot " + (streaming.value ? "streaming" : "on")}></span>
            </div>
          </div>
        </form>
        <div class="thought-stream">
          ${() => {
            const last2 = thoughts.value.slice(-2);
            while (last2.length < 2) last2.unshift(null);
            return last2.map((t) =>
              t ? html`<div class=${"thought " + t.kind}><span class="dot"></span>${t.text}</div>`
                : html`<div class="thought idle">&nbsp;</div>`,
            );
          }}
        </div>
        ${() => {
          // Live usage output for the agent — real model consumption this project, per vendor
          // (tokens + wall-clock), from the cost ledger. Sits right under the prompt box.
          const c = cost.value;
          if (!c || !c.total || !c.total.calls) return null;
          const per = Object.entries(c.byVendor || {})
            .sort((a, b) => (b[1].ms || 0) - (a[1].ms || 0))
            .map(([v, e]) => html`<span class="usage-vendor"><b>${v}</b> ${fmtTokens((e.tokensIn || 0) + (e.tokensOut || 0))} tok · ${fmtTime(e.ms)}</span>`);
          return html`<div class="usage-strip" title="Real model usage this project (see COST.md) — the tokens & time each vendor consumed on your subscription">
            <span class="usage-label">usage</span>
            <span class="usage-body">${per}</span>
            <span class="usage-total">Σ ${fmtTokens((c.total.tokensIn || 0) + (c.total.tokensOut || 0))} tok · ${fmtTime(c.total.ms)}</span>
          </div>`;
        }}
        ${() => {
          if (!consoleOpen.value) return null;
          const tab = consoleTab.value;
          const all = debugEvents.value;
          const counts = { build: 0, app: 0, server: 0 };
          for (const e of all) counts[logTabOf(e.event)]++;
          const rows = all.filter((e) => logTabOf(e.event) === tab).slice(-200);
          const label = { build: "Build", app: "App", server: "Server" };
          const empty = { build: "No activity yet — run a build to see the machinery here.", app: "No app output yet — open the preview and interact with it.", server: "No server log yet — run the project to see its output." };
          return html`
          <div class="dev-console">
            <div class="dev-console-head">
              <div class="dev-tabs">
                ${["build", "app", "server"].map((t) => html`<button class=${"dev-tab" + (tab === t ? " on" : "")} @click=${() => (consoleTab.value = t)}>${label[t]}${counts[t] ? html` <span class="dev-tab-n">${counts[t]}</span>` : null}</button>`)}
              </div>
              <button class="dev-console-clear" @click=${() => (debugEvents.value = [])}>clear</button>
            </div>
            <div class="dev-console-body">
              ${rows.length
                ? rows.map((e) => { const detail = typeof e.detail === "string" ? e.detail : (e.detail && typeof e.detail.msg === "string" ? e.detail.msg : (e.detail ? JSON.stringify(e.detail) : "")); const steerText = detail || e.event; return html`<div class="dev-line"><button class="dev-steer" title="Send this to the agent to steer it" @click=${() => steerFromLog(steerText)}>+</button><span class="dev-ev">${e.event}</span>${detail ? html`<span class="dev-detail">${detail}</span>` : null}</div>`; })
                : html`<div class="dev-line dev-empty">${empty[tab]}</div>`}
            </div>
          </div>`;
        }}
      </div>`;
  }
}
customElements.define("composer-el", ComposerEl);

// -------- ThreadBar — Level-3 multi-thread pill row --------
// Shows every live agent thread (across projects). Click a pill to attach
// to that thread and see its stream. Clicking a thread from a different
// project ALSO switches the project (so the workspace + preview + plan follow).
class ThreadBar extends Tina4Element {
  static shadow = false;
  render() {
    const list = threads.value || [];
    const attach = async (t) => {
      // If the thread lives in a different project, switch the project first
      // so the client-side workspace state (plan/preview/sessions/tree) follows.
      if (t.project && t.project !== projectsList.value.current) {
        await switchProject(t.project);
      }
      // Attach WS to that thread's actor — the old thread keeps running server-side.
      try { ws.send(JSON.stringify({ type: "thread:attach", key: t.key })); } catch {}
    };
    const dot = (s) =>
      s === "streaming" ? "●" : s === "waiting" ? "◐" : s === "done" ? "○" : "·";
    return html`
      <div class="thread-bar">
        ${list.map((t) => html`
          <button
            class=${() => "thread-pill " + (attachedThreadKey.value === t.key ? "on " : "") + t.status}
            title=${`${t.project} · ${t.status} · ${t.rounds} rounds · ${Math.round((t.totalTokens || 0) / 1000)}k tokens`}
            @click=${() => attach(t)}>
            <span class="thread-dot">${dot(t.status)}</span>
            <span class="thread-project">${t.project}</span>
            <span class="thread-title">${(t.title || t.sessionId || "").slice(0, 28)}</span>
            ${t.status === "streaming" ? html`<span class="thread-round">r${t.rounds}</span>` : null}
          </button>
        `)}
      </div>`;
  }
}
customElements.define("thread-bar", ThreadBar);

const projectOpen = signal(false);
const newProjectOpen = signal(false);
const projectPickerOpen = signal(false);
async function archiveProject(name) {
  const j = await fetch("/api/projects", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ name, action: "archive" }) }).then(r => r.json());
  if (!j?.ok) { alert("Archive failed: " + (j?.error || "?")); return j; }
  await loadProjectsList();
  if (projectsList.value.current === "") { modelInfo.value = await fetch("/api/model").then(r => r.json()); currentSessionId.value = null; localStorage.removeItem("t4a.sessionId"); messages.value = []; await loadSessions(); refreshTree(); }
  return j;
}
const projectInfo = signal({ root: "", name: "", mission: "", services: [] });
async function loadProject() {
  try {
    const j = await fetch("/api/project").then(r => r.json());
    projectInfo.value = {
      root: j?.root || "",
      name: j?.name || "",
      mission: j?.mission || "",
      services: Array.isArray(j?.services) ? j.services : [],
    };
  } catch {}
}
async function saveProject(name, services) {
  const j = await fetch("/api/project", {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify({ name, mission: projectInfo.value.mission || "", services }),
  }).then(r => r.json());
  if (j?.ok) projectInfo.value = { root: j.root, name: j.name, mission: j.mission || "", services: j.services };
  return j;
}
loadProject();

const KINDS = ["tina4-js", "tina4-nodejs", "tina4-python", "tina4-php", "tina4-ruby", "static", "worker", "other"];

const secretsList = signal([]);           // project-scoped (workspace/.secrets/)
const globalSecretsList = signal([]);     // global (~/.tina4-simple-agent/secrets/)
const draftSecretName = signal("");
const draftSecretValue = signal("");
const draftGlobalSecretName = signal("");
const draftGlobalSecretValue = signal("");

async function loadGlobalSecrets() {
  try {
    const j = await fetch("/api/global-secrets").then(r => r.json());
    globalSecretsList.value = Array.isArray(j?.names) ? j.names : [];
  } catch { globalSecretsList.value = []; }
}
async function saveGlobalSecret(name, value) {
  await fetch("/api/global-secrets", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ name, value }) });
  await loadGlobalSecrets();
}
async function deleteGlobalSecret(name) {
  await fetch("/api/global-secrets", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ name }) });
  await loadGlobalSecrets();
}
async function loadSecrets() {
  try {
    const j = await fetch("/api/secrets").then(r => r.json());
    secretsList.value = Array.isArray(j?.names) ? j.names : [];
  } catch { secretsList.value = []; }
}
async function saveSecret(name, value) {
  await fetch("/api/secrets", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ name, value }) });
  await loadSecrets();
}
async function deleteSecret(name) {
  await fetch("/api/secrets", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ name }) });
  await loadSecrets();
}

class ProjectPickerModal extends Tina4Element {
  static shadow = false;
  onMount() {
    this._esc = (e) => { if (e.key === "Escape") projectPickerOpen.value = false; };
    window.addEventListener("keydown", this._esc);
    loadProjectsList();
  }
  onUnmount() { window.removeEventListener("keydown", this._esc); }
  render() {
    return html`
      <div class="modal-backdrop" @click=${(e) => { if (e.target === e.currentTarget) projectPickerOpen.value = false; }}>
        <div class="modal" style="width:min(520px,100%)">
          <div class="modal-head">
            <h3>Projects</h3>
            <button class="modal-close" @click=${() => (projectPickerOpen.value = false)}>×</button>
          </div>
          <div class="modal-body">
            <span class="hint">Root: <code>${() => projectsList.value.projectsRoot || "~/tina4-projects"}</code></span>
            <div class="picker-list">
              ${() => projectsList.value.projects.length === 0
                ? html`<div class="secrets-empty">no projects yet — create one below</div>`
                : projectsList.value.projects.map(p => {
                    const folder = typeof p === "string" ? p : p.folder;
                    const name = typeof p === "string" ? p : (p.name || p.folder);
                    const isCurrent = folder === projectsList.value.current;
                    return html`<div class=${"picker-row" + (isCurrent ? " on" : "")}>
                      <div class="picker-name">
                        <strong>${name}</strong>
                        ${name !== folder ? html`<span class="picker-folder">${folder}</span>` : null}
                        ${isCurrent ? html`<span class="picker-badge">current</span>` : null}
                      </div>
                      <div class="picker-actions">
                        ${!isCurrent ? html`<button class="btn tiny" @click=${async () => { await switchProject(folder); projectPickerOpen.value = false; }}>switch</button>` : null}
                        <button class="btn tiny danger" @click=${async () => {
                          if (!confirm("Archive '" + name + "' (zip → delete folder)? Zip stays under .archive/ so you can restore later.")) return;
                          await archiveProject(folder);
                        }}>archive</button>
                      </div>
                    </div>`;
                  })}
            </div>
          </div>
          <div class="modal-actions">
            <button class="btn ghost" @click=${() => (projectPickerOpen.value = false)}>Cancel</button>
            <button class="btn primary" @click=${() => { projectPickerOpen.value = false; newProjectOpen.value = true; }}>+ new project</button>
          </div>
        </div>
      </div>`;
  }
}
customElements.define("project-picker-modal", ProjectPickerModal);

const newProjectTab = signal("new"); // "new" | "clone"
const newProjectBusy = signal(false);

class NewProjectModal extends Tina4Element {
  static shadow = false;
  onMount() {
    this._esc = (e) => { if (e.key === "Escape" && !isFirstRun.value) newProjectOpen.value = false; };
    window.addEventListener("keydown", this._esc);
    loadProjectsList();
    queueMicrotask(() => this.querySelector("#np-name, #np-url")?.focus());
  }
  onUnmount() { window.removeEventListener("keydown", this._esc); }
  render() {
    const closable = !isFirstRun.value;
    const create = async () => {
      const el = this.querySelector("#np-name");
      const n = el?.value.trim() ?? "";
      if (!n) return;
      if (!/^[A-Za-z0-9._-]+$/.test(n)) { alert("Name: letters/digits/._- only"); return; }
      newProjectBusy.value = true;
      const j = await createProject(n);
      newProjectBusy.value = false;
      if (j?.ok) newProjectOpen.value = false;
      else alert(j?.error || "failed");
    };
    const cloneRepo = async () => {
      const url = (this.querySelector("#np-url")?.value || "").trim();
      let name = (this.querySelector("#np-clone-name")?.value || "").trim();
      if (!url) return;
      if (!name) {
        const m = url.match(/([A-Za-z0-9._-]+?)(?:\.git)?\/?$/);
        name = m ? m[1] : "";
      }
      if (!name || !/^[A-Za-z0-9._-]+$/.test(name)) { alert("Folder name: letters/digits/._- only"); return; }
      newProjectBusy.value = true;
      const j = await fetch("/api/projects", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ action: "clone", url, name }),
      }).then(r => r.json()).catch(() => null);
      newProjectBusy.value = false;
      if (j?.ok) { await _rescopeAfterProjectChange(); newProjectOpen.value = false; }
      else alert(j?.error || "clone failed");
    };
    const tabBtn = (id, label) => html`<button
      class=${() => "tab-btn " + (newProjectTab.value === id ? "on" : "")}
      @click=${() => (newProjectTab.value = id)}>${label}</button>`;
    return html`
      <div class="modal-backdrop" @click=${(e) => { if (closable && e.target === e.currentTarget) newProjectOpen.value = false; }}>
        <div class="modal" style="width:min(480px,100%)">
          <div class="modal-head">
            <h3>${() => isFirstRun.value ? "Welcome — create your first project" : "New project"}</h3>
            ${() => closable ? html`<button class="modal-close" @click=${() => (newProjectOpen.value = false)}>×</button>` : null}
          </div>
          <div class="modal-body">
            <div class="tab-row">
              ${tabBtn("new", "New empty")}
              ${tabBtn("clone", "Clone a repo")}
            </div>
            ${() => newProjectTab.value === "new" ? html`
              <label>
                <span>Name</span>
                <input id="np-name" type="text" placeholder="my-app"
                  @keydown=${(e) => { if (e.key === "Enter") create(); }}>
                <span class="hint">Creates <code>${() => (projectsList.value.projectsRoot || "~/tina4-projects")}/&lt;name&gt;/</code> and switches to it. Letters/digits/._- only.</span>
              </label>
            ` : html`
              <label>
                <span>Git URL</span>
                <input id="np-url" type="text" placeholder="git@github.com:you/repo.git  or  https://github.com/you/repo"
                  @keydown=${(e) => { if (e.key === "Enter") cloneRepo(); }}>
              </label>
              <label>
                <span>Folder name <span class="hint">(optional — inferred from URL)</span></span>
                <input id="np-clone-name" type="text" placeholder="my-app"
                  @keydown=${(e) => { if (e.key === "Enter") cloneRepo(); }}>
                <span class="hint">Clones into <code>${() => (projectsList.value.projectsRoot || "~/tina4-projects")}/&lt;folder&gt;/</code> and switches to it.</span>
              </label>
            `}
          </div>
          <div class="modal-actions">
            ${() => closable ? html`<button class="btn ghost" @click=${() => (newProjectOpen.value = false)}>Cancel</button>` : null}
            ${() => newProjectTab.value === "new"
              ? html`<button class="btn primary" .disabled=${() => newProjectBusy.value} @click=${create}>${() => newProjectBusy.value ? "Creating…" : "Create"}</button>`
              : html`<button class="btn primary" .disabled=${() => newProjectBusy.value} @click=${cloneRepo}>${() => newProjectBusy.value ? "Cloning…" : "Clone"}</button>`}
          </div>
        </div>
      </div>`;
  }
}
customElements.define("new-project-modal", NewProjectModal);

class ProjectModal extends Tina4Element {
  static shadow = false;
  onMount() {
    this._esc = (e) => { if (e.key === "Escape") projectOpen.value = false; };
    window.addEventListener("keydown", this._esc);
    loadProject(); loadSecrets(); loadProjectsList();
  }
  onUnmount() { window.removeEventListener("keydown", this._esc); }
  render() {
    return html`
      <div class="modal-backdrop" @click=${(e) => { if (e.target === e.currentTarget) projectOpen.value = false; }}>
        <div class="modal" style="width:min(720px,100%)">
          <div class="modal-head">
            <h3>Project — ${() => projectsList.value.current || projectInfo.value.name || "workspace"}</h3>
            <button class="modal-close" @click=${() => (projectOpen.value = false)}>×</button>
          </div>
          <div class="modal-body">
            <label>
              <span>Switch project — <code>${() => projectsList.value.projectsRoot || "no root set"}</code></span>
              <div class="proj-switch">
                <select @change=${(e) => e.target.value && switchProject(e.target.value)}>
                  ${() => projectsList.value.projects.length === 0
                    ? html`<option value="">(no projects yet — create one below)</option>`
                    : html`${projectsList.value.projects.map(p => {
                        const folder = typeof p === "string" ? p : p.folder;
                        const name = typeof p === "string" ? p : (p.name || p.folder);
                        const label = name === folder ? folder : `${name} (${folder})`;
                        return html`<option value=${folder} selected=${folder === projectsList.value.current}>${label}</option>`;
                      })}`}
                </select>
                <input type="text" placeholder="new-project-name" id="new-proj-name">
                <button class="btn tiny primary" @click=${async () => {
                  const el = document.getElementById("new-proj-name");
                  const n = el.value.trim();
                  if (!n || !/^[A-Za-z0-9._-]+$/.test(n)) { alert("Name: letters/digits/._- only"); return; }
                  const j = await createProject(n);
                  if (j?.ok) el.value = "";
                }}>+ new</button>
              </div>
              <span class="hint">Each project is a subfolder of the projects root. Set the root in Settings.</span>
            </label>
            <label>
              <span>This project's display name</span>
              <input type="text" id="proj-edit-name" .value=${() => projectInfo.value.name || ""}
                placeholder="my-app">
            </label>
            <label>
              <span>Mission</span>
              <input type="text" id="proj-edit-mission" .value=${() => projectInfo.value.mission || ""}
                placeholder="the north star — injected into every session's prompt">
            </label>

            <fieldset class="secrets-block">
              <legend>Services — where each thing lives</legend>
              <span class="hint">The agent reads <code>.tina4-agent.json</code> and directs code to the matching <em>path</em>. Add one row per subsystem.</span>
              <div class="proj-list">
                ${() => (projectInfo.value.services.length === 0
                  ? html`<div class="secrets-empty">no services declared — add one below</div>`
                  : html`${projectInfo.value.services.map((s, i) => html`
                      <div class="proj-row">
                        <code class="secret-name">${s.name}</code>
                        <span class="proj-kind">${s.kind}</span>
                        <code class="proj-path">${s.path}</code>
                        ${s.port ? html`<span class="proj-port">:${s.port}</span>` : null}
                        <button class="btn tiny danger" @click=${async () => {
                          if (!confirm("Remove '" + s.name + "'?")) return;
                          const next = projectInfo.value.services.filter((_, j) => j !== i);
                          await saveProject(projectInfo.value.name || "", next);
                        }}>remove</button>
                      </div>`)}`)}
              </div>
              <div class="proj-add simple">
                <input class="proj-in name"  type="text" placeholder="name (frontend)"  id="proj-add-name">
                <select class="proj-in kind" id="proj-add-kind">
                  ${KINDS.map(k => html`<option value=${k}>${k}</option>`)}
                </select>
                <input class="proj-in path"  type="text" placeholder="folder (public)"  id="proj-add-path">
                <button class="btn tiny primary" @click=${async () => {
                  const n = document.getElementById("proj-add-name").value.trim();
                  const k = document.getElementById("proj-add-kind").value.trim();
                  const p = document.getElementById("proj-add-path").value.trim();
                  if (!n || !k || !p) { alert("name, kind, folder are required"); return; }
                  if (!/^[A-Za-z0-9_.-]+$/.test(n)) { alert("name: letters/digits/._- only"); return; }
                  // port + runCmd are inferred from kind + workspace scan at run time.
                  const next = [...projectInfo.value.services, { name: n, kind: k, path: p, port: null, runCmd: null }];
                  const j = await saveProject(projectInfo.value.name || "", next);
                  if (!j?.ok) { alert(j?.error || "save failed"); return; }
                  ["name", "path"].forEach((f) => { document.getElementById("proj-add-" + f).value = ""; });
                }}>add</button>
              </div>
              <span class="hint">Port and run command are auto-detected from the folder + kind (via <code>get_free_port</code> + the workspace manifest). You don't have to enter them.</span>
            </fieldset>

            <fieldset class="secrets-block">
              <legend>Project secrets — <code>${() => projectInfo.value.root || "workspace"}/.secrets/</code> (git-ignored)</legend>
              <span class="hint">Overrides a global secret of the same name. Files chmod 0600. Deleting removes the file.</span>
              <div class="secrets-list">
                ${() => secretsList.value.length === 0
                  ? html`<div class="secrets-empty">no project secrets — add one below or use a global secret from Settings</div>`
                  : html`${secretsList.value.map(n => html`
                      <div class="secret-row">
                        <code class="secret-name">${n}</code>
                        <button class="btn tiny ghost" @click=${async () => {
                          const v = prompt("New value for " + n);
                          if (v && v.length) await saveSecret(n, v);
                        }}>replace</button>
                        <button class="btn tiny danger" @click=${async () => {
                          if (confirm("Delete secret " + n + "?")) await deleteSecret(n);
                        }}>delete</button>
                      </div>`)}`}
              </div>
              <div class="secret-add">
                <input type="text" placeholder="NAME" .value=${draftSecretName}
                  @input=${(e) => (draftSecretName.value = e.target.value)}>
                <input type="password" placeholder="value" .value=${draftSecretValue}
                  @input=${(e) => (draftSecretValue.value = e.target.value)}>
                <button class="btn tiny primary" @click=${async () => {
                  const n = draftSecretName.value.trim(); const v = draftSecretValue.value;
                  if (!n || !/^[A-Za-z0-9_.-]+$/.test(n)) { alert("Name: letters/digits/._- only"); return; }
                  if (!v) return;
                  await saveSecret(n, v);
                  draftSecretName.value = ""; draftSecretValue.value = "";
                }}>add</button>
              </div>
            </fieldset>
          </div>
          <div class="modal-actions">
            <button class="btn ghost" @click=${() => (projectOpen.value = false)}>Cancel</button>
            <button class="btn primary" @click=${async () => {
              const name = (document.getElementById("proj-edit-name")?.value || "").trim();
              const mission = (document.getElementById("proj-edit-mission")?.value || "").trim();
              const j = await fetch("/api/project", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ ...projectInfo.value, name, mission }),
              }).then(r => r.json()).catch(() => null);
              if (!j?.ok) { alert(j?.error || "save failed"); return; }
              await loadProject();
              projectOpen.value = false;
            }}>Save</button>
          </div>
        </div>
      </div>`;
  }
}
customElements.define("project-modal", ProjectModal);

class SettingsModal extends Tina4Element {
  static shadow = false;
  onMount() {
    this._esc = (e) => { if (e.key === "Escape") settingsOpen.value = false; };
    window.addEventListener("keydown", this._esc);
    loadGlobalSecrets();
    loadDoctor();
  }
  onUnmount() { window.removeEventListener("keydown", this._esc); }
  render() {
    const save = async () => {
      const modelPayload = {
        endpoint: draftEndpoint.value.trim(),
        model: draftModel.value.trim(),
        ...(draftToken.value ? { token: draftToken.value } : {}),
        ...(draftMcpUrl.value ? { mcpUrl: draftMcpUrl.value.trim() } : {}),
        ...(draftMcpToken.value ? { mcpToken: draftMcpToken.value } : {}),
        ...(draftProjectsRoot.value ? { projectsRoot: draftProjectsRoot.value.trim() } : {}),
        engine: {
          gwContext: !!draftGwContext.value,
          gwKeepRounds: Number(draftGwKeepRounds.value) || 10,
          gwK: Number(draftGwK.value) || 6,
          anthropicCache1h: !!draftCache1h.value,
        },
        thinking: {
          enabled: !!draftThinking.value,
          model: draftThinkingModel.value.trim() || "claude-opus-4-8",
          delegateCap: Number(draftDelegateCap.value) || 24,
        },
      };
      const wsPayload = { path: draftWorkspace.value.trim() };
      try {
        await fetch("/api/model", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(modelPayload) });
        const wsRes = await fetch("/api/workspace", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(wsPayload) }).then(r => r.json());
        if (!wsRes.ok) {
          alert("Workspace: " + (wsRes.error || "invalid path"));
          return;
        }
        await fetch("/api/actor", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            name: draftActorName.value.trim(),
            email: draftActorEmail.value.trim(),
            autoSync: !!draftAutoSync.value,
          }),
        });
        await loadActor();
        const j = await fetch("/api/model").then((r) => r.json());
        modelInfo.value = j;
      } catch (e) { /* toast could go here */ }
      settingsOpen.value = false;
    };
    return html`
      <div class="modal-backdrop" @click=${(e) => { if (e.target === e.currentTarget) settingsOpen.value = false; }}>
        <div class="modal wide">
          <div class="modal-head">
            <h3>Settings</h3>
            <button class="modal-close" @click=${() => (settingsOpen.value = false)}>×</button>
          </div>
          <div class="modal-body">
            <fieldset class="secrets-block">
              <legend>System check — what this machine can build &amp; run</legend>
              <span class="hint">The tina4 CLI is downloaded automatically on first use. Runtimes below are what a scaffolded app needs; missing ones must be installed on the machine.</span>
              ${() => doctorLoading.value && !doctorInfo.value
                ? html`<div class="secrets-empty">checking…</div>`
                : (() => {
                    const d = doctorInfo.value || {};
                    const row = (label, ok, ver) => html`<div class="doc-row">
                      <span class=${"doc-dot " + (ok ? "ok" : "bad")}>${ok ? "✓" : "✗"}</span>
                      <span class="doc-name">${label}</span>
                      <span class="doc-ver">${ver || (ok ? "" : "not found")}</span>
                    </div>`;
                    return html`<div class="doc-grid">
                      ${row("tina4 CLI", d.tina4?.ok, d.tina4?.path ? "ready" : (d.tina4?.downloadable ? "will download" : ""))}
                      ${row("Node.js", d.node?.ok, d.node?.version)}
                      ${row("npm", d.npm?.ok, d.npm?.version)}
                      ${row("Python", d.python3?.ok, d.python3?.version)}
                      ${row("PHP", d.php?.ok, d.php?.version)}
                      ${row("Ruby", d.ruby?.ok, d.ruby?.version)}
                      ${row("git", d.git?.ok, d.git?.version)}
                      ${row("Chrome (preview)", d.chrome?.ok, d.chrome?.ok ? "" : "optional")}
                    </div>`;
                  })()}
              <div class="doc-actions">
                <button class="btn tiny" @click=${loadDoctor} .disabled=${() => doctorLoading.value}>${() => doctorLoading.value ? "checking…" : "re-check"}</button>
                <button class="btn tiny primary" @click=${prepareSystem} .disabled=${() => doctorPreparing.value}>${() => doctorPreparing.value ? "preparing…" : "prepare (download tina4 CLI)"}</button>
                ${() => doctorInfo.value?.tina4Doctor
                  ? html`<details class="doc-details"><summary>full report</summary><pre class="doc-report">${doctorInfo.value.tina4Doctor}</pre></details>`
                  : null}
              </div>
            </fieldset>
            <fieldset class="vendors-fs">
              <legend>Vendors — bring your own</legend>
              <div class="hint">Log in to a vendor's own client (your subscription, not an API key) and use its models here. Each role picks independently, so you can mix (e.g. thinker = Tina4, coder = Cursor Composer).</div>
              <div class="vendor-rows">
                ${() => (modelInfo.value.vendors || []).map(v => html`
                  <div class="vendor-row ${v.status}">
                    <span class="vendor-name">${v.label}${v.primary ? html`<span class="vendor-badge">native</span>` : null}</span>
                    <span class="vendor-status ${v.status}">${
                      v.status === "connected" ? `✓ ${v.account || "signed in"}`
                      : v.status === "expired" ? "⚠ session expired — re-login"
                      : v.status === "loggedout" ? (v.loginHint || "sign in")
                      : (v.reason || v.installHint || "unavailable")}</span>
                  </div>`)}
              </div>
              <label class="vendor-pick">
                <span>Coder model</span>
                <select class="mdl-select" .value=${() => `${modelInfo.value.coderVendor || "tina4"}:${modelInfo.value.coderVendorModel || "tina4-coder"}`}
                  @change=${async (e) => { const [vendor, ...rest] = e.target.value.split(":"); const model = rest.join(":"); await fetch("/api/model", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ coderVendor: vendor, coderModel: model }) }); modelInfo.value = await fetch("/api/model").then(r => r.json()); }}>
                  ${() => (modelInfo.value.vendors || []).filter(v => (v.coderModels || []).length).map(v => html`
                    <optgroup label=${`${v.label}${v.status === "connected" ? "" : v.status === "expired" ? " (expired)" : v.primary ? "" : " (sign in)"}`}>
                      ${v.coderModels.map(m => html`<option value=${`${v.id}:${m.id}`} .disabled=${v.status !== "connected"}>⌨ ${v.label} · ${m.label}</option>`)}
                    </optgroup>`)}
                </select>
                <span class="hint">Which vendor's model writes your code. Greyed-out vendors need a login first.</span>
              </label>
              <label class="vendor-pick">
                <span>Thinker model</span>
                <select class="mdl-select" .value=${() => `${modelInfo.value.thinkerVendor || "tina4"}:${modelInfo.value.thinkerVendorModel || "tina4-thinker"}`}
                  @change=${async (e) => { const [vendor, ...rest] = e.target.value.split(":"); const model = rest.join(":"); await fetch("/api/model", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ thinkerVendor: vendor, thinkerVendorModel: model }) }); modelInfo.value = await fetch("/api/model").then(r => r.json()); }}>
                  ${() => (modelInfo.value.vendors || []).filter(v => (v.thinkerModels || []).length).map(v => html`
                    <optgroup label=${`${v.label}${v.status === "connected" ? "" : v.status === "expired" ? " (expired)" : v.primary ? "" : " (sign in)"}`}>
                      ${v.thinkerModels.map(m => html`<option value=${`${v.id}:${m.id}`} .disabled=${v.status !== "connected"}>🧠 ${v.label} · ${m.label}</option>`)}
                    </optgroup>`)}
                </select>
                <span class="hint">Reasoning + vision — plans the build, reviews the UI, describes images. Pick a different vendor here to mix.</span>
              </label>
            </fieldset>
            <label>
              <span>Model endpoint</span>
              <input type="url" .value=${draftEndpoint}
                @input=${(e) => (draftEndpoint.value = e.target.value)}
                placeholder="http://192.168.88.99:11460/v1">
              <span class="hint">OpenAI-compatible base URL. Must include <code>/v1</code>.</span>
            </label>
            <label>
              <span>Model id</span>
              <input type="text" .value=${draftModel}
                @input=${(e) => (draftModel.value = e.target.value)}
                placeholder="tina4-coder">
            </label>
            <label>
              <span>Bearer token</span>
              <input type="password" .value=${draftToken}
                @input=${(e) => (draftToken.value = e.target.value)}
                placeholder="leave blank to keep current">
              <span class="hint">Sent as <code>Authorization: Bearer …</code>. Stored in-memory server-side only.</span>
            </label>
            <label>
              <span>Projects folder (global)</span>
              <input type="text" .value=${draftProjectsRoot}
                @input=${(e) => (draftProjectsRoot.value = e.target.value)}
                placeholder="~/tina4-projects">
              <span class="hint">All projects live as subfolders here. Switch/create projects from the topbar's project pill. Defaults to <code>~/tina4-projects</code>.</span>
            </label>
            <fieldset class="secrets-block">
              <legend>You — for team collaboration &amp; cross-machine resume</legend>
              <span class="hint">Your email keys the "last-open session" pointer so the same person on a different machine picks up exactly where they left off. Auto-sync commits <code>plan/</code> + <code>.tina4-agent/</code> and pushes at the end of every turn (needs a git remote configured in the project).</span>
              <label>
                <span>Name</span>
                <input type="text" .value=${draftActorName}
                  @input=${(e) => (draftActorName.value = e.target.value)}
                  placeholder="e.g. Alice Chen">
              </label>
              <label>
                <span>Email</span>
                <input type="email" .value=${draftActorEmail}
                  @input=${(e) => (draftActorEmail.value = e.target.value)}
                  placeholder="alice@example.com">
                <span class="hint">Falls back to <code>git config --global user.email</code> when blank.</span>
              </label>
              <label class="checkbox-row">
                <input type="checkbox" .checked=${draftAutoSync}
                  @change=${(e) => (draftAutoSync.value = e.target.checked)}>
                <span>Auto-sync — commit &amp; push at the end of every turn</span>
              </label>
            </fieldset>
            <label>
              <span>Tina4 MCP endpoint</span>
              <input type="url" .value=${draftMcpUrl}
                @input=${(e) => (draftMcpUrl.value = e.target.value)}
                placeholder="https://mcp.tina4.com/mcp">
              <span class="hint">JSON-RPC MCP endpoint the <code>tina4_context</code> tool calls for live framework grounding.</span>
            </label>
            <label>
              <span>Tina4 MCP token</span>
              <input type="password" .value=${draftMcpToken}
                @input=${(e) => (draftMcpToken.value = e.target.value)}
                placeholder="leave blank to keep current">
              <span class="hint">Bearer token for <code>mcp.tina4.com</code>. Default is <code>FRESH-TOKEN</code>. Register at <a href="https://profile.tina4.com" target="_blank" rel="noopener">profile.tina4.com</a> for your own.</span>
            </label>
            <fieldset class="secrets-block">
              <legend>Engine — context &amp; caching</legend>
              <span class="hint">The <strong>rotating context window</strong> keeps a fixed live window and retrieves older turns from a lossless index instead of resending them — per-round context stays flat as the app grows (never compressed, never cleaned). Prompt caching is separate: it reuses the stable prefix.</span>
              <label class="checkbox-row">
                <input type="checkbox" .checked=${draftGwContext}
                  @change=${(e) => (draftGwContext.value = e.target.checked)}>
                <span>Rotating context window (Groundwire retrieval)</span>
              </label>
              <label>
                <span>Live window (units kept verbatim)</span>
                <input type="number" min="1" max="40" .value=${draftGwKeepRounds}
                  @input=${(e) => (draftGwKeepRounds.value = Number(e.target.value))}
                  .disabled=${() => !draftGwContext.value}>
                <span class="hint">How many recent conversation units stay in the prompt uncompressed. Lower = smaller window, more retrieval.</span>
              </label>
              <label>
                <span>Retrieved chunks per round (k)</span>
                <input type="number" min="1" max="24" .value=${draftGwK}
                  @input=${(e) => (draftGwK.value = Number(e.target.value))}
                  .disabled=${() => !draftGwContext.value}>
                <span class="hint">Top-k relevant chunks pulled back from the index each round.</span>
              </label>
              <label class="checkbox-row">
                <input type="checkbox" .checked=${draftCache1h}
                  @change=${(e) => (draftCache1h.value = e.target.checked)}>
                <span>Extended 1-hour prompt cache (Opus / Anthropic path only)</span>
              </label>
              <span class="hint">Default cache TTL is 5 minutes. The 1-hour TTL keeps the cached prefix warm across longer gaps — Anthropic path only; has no effect on tina4-coder.</span>
            </fieldset>
            <fieldset class="secrets-block">
              <legend>Thinking mode — Opus orchestrates, tina4-coder codes</legend>
              <span class="hint">When on, <strong>Claude Opus</strong> reasons, decomposes, and reviews — and delegates all the actual code-writing to <strong>tina4-coder</strong>, verifying each result by running it. Opus never writes the feature code itself. You see Opus's live thinking. Needs an Anthropic key.</span>
              <label class="checkbox-row">
                <input type="checkbox" .checked=${draftThinking}
                  @change=${(e) => (draftThinking.value = e.target.checked)}>
                <span>Enable Thinking mode (opt-in)</span>
              </label>
              ${() => draftThinking.value && !thinkingKeyAvailable.value
                ? html`<span class="hint" style="color:var(--danger,#c0392b)">⚠ No Anthropic key found. Add a global secret named <code>AK</code> (or set <code>ANTHROPIC_API_KEY</code>) or Thinking mode can't orchestrate.</span>`
                : ""}
              <label>
                <span>Planner (orchestrator) model</span>
                <input type="text" .value=${draftThinkingModel}
                  @input=${(e) => (draftThinkingModel.value = e.target.value)}
                  .disabled=${() => !draftThinking.value}
                  placeholder="claude-opus-4-8">
                <span class="hint">Claude Opus 4.7 or 4.8. This model orchestrates only — it does not do the coding.</span>
              </label>
              <label>
                <span>Delegation cap (max coder calls per turn)</span>
                <input type="number" min="1" max="200" .value=${draftDelegateCap}
                  @input=${(e) => (draftDelegateCap.value = Number(e.target.value))}
                  .disabled=${() => !draftThinking.value}>
                <span class="hint">Hard cost/runaway limit. When hit, Opus is told to stop delegating and finish with what it has. Default 24.</span>
              </label>
            </fieldset>
            <fieldset class="secrets-block">
              <legend>Global secrets — <code>~/.tina4-simple-agent/secrets/</code></legend>
              <span class="hint">Shared across all projects. A project-scoped secret of the same name overrides these (edit those from the project pill in the topbar).</span>
              <div class="secrets-list">
                ${() => globalSecretsList.value.length === 0
                  ? html`<div class="secrets-empty">no global secrets yet — add one below</div>`
                  : html`${globalSecretsList.value.map(n => html`
                      <div class="secret-row">
                        <code class="secret-name">${n}</code>
                        <button class="btn tiny ghost" @click=${async () => {
                          const v = prompt("New value for " + n);
                          if (v && v.length) await saveGlobalSecret(n, v);
                        }}>replace</button>
                        <button class="btn tiny danger" @click=${async () => {
                          if (confirm("Delete global secret " + n + "?")) await deleteGlobalSecret(n);
                        }}>delete</button>
                      </div>`)}`}
              </div>
              <div class="secret-add">
                <input type="text" placeholder="NAME (e.g. ANTHROPIC_API_KEY)" .value=${draftGlobalSecretName}
                  @input=${(e) => (draftGlobalSecretName.value = e.target.value)}>
                <input type="password" placeholder="value" .value=${draftGlobalSecretValue}
                  @input=${(e) => (draftGlobalSecretValue.value = e.target.value)}>
                <button class="btn tiny primary" @click=${async () => {
                  const n = draftGlobalSecretName.value.trim(); const v = draftGlobalSecretValue.value;
                  if (!n || !/^[A-Za-z0-9_.-]+$/.test(n)) { alert("Name: letters/digits/._- only"); return; }
                  if (!v) return;
                  await saveGlobalSecret(n, v);
                  draftGlobalSecretName.value = ""; draftGlobalSecretValue.value = "";
                }}>add</button>
              </div>
            </fieldset>
          </div>
          <div class="modal-actions">
            <button class="btn danger" @click=${async () => {
              if (!confirm("Quit Tina4 Agent? Running turns will stop.")) return;
              try { await fetch("/api/quit", { method: "POST" }); } catch {}
              document.body.innerHTML = '<div style="display:flex;height:100vh;align-items:center;justify-content:center;font:500 15px system-ui;color:#888">Tina4 Agent has quit — you can close this window.</div>';
            }}>Quit</button>
            <span style="flex:1"></span>
            <button class="btn ghost" @click=${() => (settingsOpen.value = false)}>Cancel</button>
            <button class="btn primary" @click=${save}>Save</button>
          </div>
        </div>
      </div>`;
  }
}
