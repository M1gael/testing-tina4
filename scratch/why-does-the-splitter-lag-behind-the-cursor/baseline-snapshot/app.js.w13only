  build:     () => svgWrap("M14.7 6.3l3 3M4 20l4-1 10-10-3-3L5 16l-1 4z"),
  review:    () => svgWrap("M4 12a8 8 0 018-8 8 8 0 016.32 3.1M20 4v5h-5M20 12a8 8 0 01-8 8 8 8 0 01-6.32-3.1M4 20v-5h5"),
