new file mode 100644
index 0000000..30c26bc
--- /dev/null
+++ b/tests/update_verifies_download.rs
@@ -0,0 +1,237 @@
+//! `tina4 update` must not install bytes the release did not publish.
+//!
+//! These drive the real `tina4 update`. The unit tests cover the comparison
+//! itself and every one of them stays green while the verification is lifted
+//! back out of `handle_update` — nothing in them runs the command, and the
+//! whole user-visible defect is at the call site.
+//!
+//! The runs are hermetic: PATH holds one directory containing a stand-in
+//! `curl`, so there is no network and nothing else on the machine is
+//! reachable. The stand-in answers the release API with a version that forces
+//! the download path, then serves whatever this test wants the "download" to
+//! be. The binary under test is a copy, because a successful update replaces
+//! its own executable.
+
+#![cfg(unix)]
+
+use std::os::unix::fs::PermissionsExt;
+use std::path::PathBuf;
+use std::process::{Command, Stdio};
+
+const BIN: &str = env!("CARGO_BIN_EXE_tina4");
+const PAYLOAD: &str = "tina4 fake payload bytes\n";
+const PAYLOAD_SHA: &str = "054e3d2cff15fecd74bbc3724e807d0997ff4b770b3fd15e59c78c000d470e80";
+
+struct Sandbox {
+    root: PathBuf,
+}
+
+impl Drop for Sandbox {
+    fn drop(&mut self) {
+        std::fs::remove_dir_all(&self.root).ok();
+    }
+}
+
+impl Sandbox {
+    fn cli(&self) -> PathBuf {
+        self.root.join("tina4")
+    }
+}
+
+/// `sums` is what the stand-in serves for SHA256SUMS. Empty means the release
+/// publishes none, which the stand-in reports as curl's 22 (an HTTP refusal).
+/// `"!23"` means the fetch failed on THIS machine — curl's 23 is a write
+/// failure — which is a different thing and must not be read as "none
+/// published".
+fn sandbox(tag: &str, sums: &str) -> Sandbox {
+    let root = std::env::temp_dir().join(format!(
+        "tina4-verify-dl-{}-{}-{}",
+        tag,
+        std::process::id(),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.subsec_nanos())
+            .unwrap_or(0)
+    ));
+    std::fs::create_dir_all(root.join("fakebin")).expect("create the stand-in bin directory");
+    std::fs::create_dir_all(root.join("home")).expect("create the sandbox home");
+    std::fs::copy(BIN, root.join("tina4")).expect("copy the binary under test");
+    std::fs::set_permissions(root.join("tina4"), std::fs::Permissions::from_mode(0o755)).unwrap();
+
+    // Only `printf` and `[` are used, both shell builtins, so the stand-in
+    // needs nothing on PATH but itself.
+    let script = format!(
+        "#!/bin/sh\n\
+         SUMS='{sums}'\n\
+         PAYLOAD='{payload}'\n\
+         dest=''\n\
+         url=''\n\
+         prev=''\n\
+         for a in \"$@\"; do\n\
+         \tif [ \"$prev\" = '-o' ]; then dest=\"$a\"; fi\n\
+         \tcase \"$a\" in http*) url=\"$a\";; esac\n\
+         \tprev=\"$a\"\n\
+         done\n\
+         case \"$url\" in\n\
+         \t*api.github.com*) printf '%s' '{{\"tag_name\": \"v9.9.9\"}}'; exit 0;;\n\
+         \t*SHA256SUMS) [ -n \"$SUMS\" ] || exit 22; [ \"$SUMS\" = '!23' ] && exit 23; printf '%s' \"$SUMS\" > \"$dest\"; exit 0;;\n\
+         \t*) printf '%s' \"$PAYLOAD\" > \"$dest\"; exit 0;;\n\
+         esac\n",
+        sums = sums,
+        payload = PAYLOAD,
+    );
+    let curl = root.join("fakebin").join("curl");
+    std::fs::write(&curl, script).expect("write the stand-in curl");
+    std::fs::set_permissions(&curl, std::fs::Permissions::from_mode(0o755)).unwrap();
+    Sandbox { root }
+}
+
+fn run_update(sb: &Sandbox) -> (i32, String) {
+    let out = Command::new(sb.cli())
+        .arg("update")
+        .env_clear()
+        .env("PATH", sb.root.join("fakebin"))
+        .env("HOME", sb.root.join("home"))
+        .env("TERM", "dumb")
+        .current_dir(&sb.root)
+        .stdin(Stdio::null())
+        .output();
+
+    // Another test thread writing its own copy of the binary can leave this
+    // one exec'ing a file the kernel still sees as open for write (ETXTBSY).
+    // That is the harness, not the CLI, so retry rather than fail.
+    let out = match out {
+        Ok(out) => out,
+        Err(e) if e.raw_os_error() == Some(26) => {
+            std::thread::sleep(std::time::Duration::from_millis(100));
+            Command::new(sb.cli())
+                .arg("update")
+                .env_clear()
+                .env("PATH", sb.root.join("fakebin"))
+                .env("HOME", sb.root.join("home"))
+                .env("TERM", "dumb")
+                .current_dir(&sb.root)
+                .stdin(Stdio::null())
+                .output()
+                .expect("run tina4 update after ETXTBSY")
+        }
+        Err(e) => panic!("run tina4 update: {e}"),
+    };
+    (
+        out.status.code().unwrap_or(-1),
+        format!(
+            "{}{}",
+            String::from_utf8_lossy(&out.stdout),
+            String::from_utf8_lossy(&out.stderr)
+        ),
+    )
+}
+
+fn installed(sb: &Sandbox) -> Vec<u8> {
+    std::fs::read(sb.cli()).expect("read the binary under test")
+}
+
+/// The defect: bytes the release never published were installed over the
+/// running CLI, reported as success, with the backup already deleted.
+#[test]
+fn update_refuses_a_download_that_does_not_match_the_published_checksum() {
+    let sums = format!("{}  tina4-linux-amd64\n", "a".repeat(64));
+    let sb = sandbox("mismatch", &sums);
+    let before = installed(&sb);
+
+    let (code, text) = run_update(&sb);
+
+    assert_ne!(
+        code, 0,
+        "a refused install must be visible to whatever ran it:\n{text}"
+    );
+    assert!(
+        text.contains("Refusing to install"),
+        "the refusal has to say so:\n{text}"
+    );
+    assert!(
+        !text.contains("Updated tina4 CLI"),
+        "nothing was installed, so nothing may claim it was:\n{text}"
+    );
+    assert_eq!(
+        installed(&sb),
+        before,
+        "the running CLI must be exactly as it was"
+    );
+}
+
+/// Positive control: bytes that DO match are installed. Without this the
+/// refusal above could be a self-update that simply never works.
+#[test]
+fn update_installs_a_download_that_matches_the_published_checksum() {
+    let sums = format!("{PAYLOAD_SHA}  tina4-linux-amd64\n");
+    let sb = sandbox("match", &sums);
+
+    let (_, text) = run_update(&sb);
+
+    assert!(
+        text.contains("Checksum verified"),
+        "a verified install has to say what it checked:\n{text}"
+    );
+    assert_eq!(
+        installed(&sb),
+        PAYLOAD.as_bytes(),
+        "the verified bytes are the ones that should land"
+    );
+}
+
+/// Negative edge — the guard must not be too tight. Releases before 3.8.53
+/// publish no SHA256SUMS, and install.sh's rule is to verify strictly only
+/// when it is present. The update path matches that, and says so out loud.
+#[test]
+fn update_without_a_published_checksum_installs_but_says_it_did_not_verify() {
+    let sb = sandbox("nosums", "");
+
+    let (_, text) = run_update(&sb);
+
+    assert!(
+        text.contains("without verifying"),
+        "an unverified install must not look like a verified one:\n{text}"
+    );
+    assert_eq!(installed(&sb), PAYLOAD.as_bytes());
+}
+
+/// Negative edge — a fetch that failed on THIS machine is not "none published".
+/// Saying so would be false, and installing anyway lets a local condition —
+/// no space, no permission, no route — switch verification off silently.
+#[test]
+fn update_refuses_when_the_checksums_cannot_be_fetched_locally() {
+    let sb = sandbox("localfail", "!23");
+    let before = installed(&sb);
+
+    let (code, text) = run_update(&sb);
+
+    assert_ne!(code, 0, "{text}");
+    assert!(
+        text.contains("Could not fetch SHA256SUMS"),
+        "the real reason has to be named, not 'none published':\n{text}"
+    );
+    assert!(
+        !text.contains("No SHA256SUMS published"),
+        "a local failure must not be reported as an absent file:\n{text}"
+    );
+    assert!(
+        !text.contains("Updated tina4 CLI"),
+        "nothing was installed, so nothing may claim it was:\n{text}"
+    );
+    assert_eq!(installed(&sb), before, "the running CLI must be untouched");
+}
+
+/// Negative edge — an asset the release does not list is not a free pass.
+#[test]
+fn update_refuses_when_the_asset_is_not_listed_in_the_checksums() {
+    let sums = format!("{PAYLOAD_SHA}  some-other-asset\n");
+    let sb = sandbox("unlisted", &sums);
+    let before = installed(&sb);
+
+    let (code, text) = run_update(&sb);
+
+    assert_ne!(code, 0, "{text}");
+    assert!(text.contains("does not list this asset"), "{text}");
+    assert_eq!(installed(&sb), before);
+}
