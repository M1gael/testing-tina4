+/// The sha256 of a file, lowercase hex, streamed so a 9 MB binary is not held
+/// in memory twice.
+fn sha256_file(path: &std::path::Path) -> std::io::Result<String> {
+    use sha2::{Digest, Sha256};
+    let mut file = std::fs::File::open(path)?;
+    let mut hasher = Sha256::new();
+    std::io::copy(&mut file, &mut hasher)?;
+    Ok(hasher
+        .finalize()
+        .iter()
+        .map(|b| format!("{b:02x}"))
+        .collect())
+}
+
+/// Pull one asset's expected digest out of a `SHA256SUMS` file.
+///
+/// The format is `sha256sum`'s own: `<64 hex>  <name>`, one per line. The name
+/// is compared whole -- `tina4-linux-amd64` must not be answered by the line
+/// for `tina4-linux-amd64.exe`.
+fn sha256_for_asset(sums: &str, asset: &str) -> Option<String> {
+    sums.lines().find_map(|line| {
+        let mut parts = line.split_whitespace();
+        let digest = parts.next()?;
+        let name = parts.next()?;
+        // `sha256sum -b` marks binary mode with a `*` before the name.
+        let name = name.strip_prefix('*').unwrap_or(name);
+        (name == asset && digest.len() == 64).then(|| digest.to_ascii_lowercase())
+    })
+}
+
+/// Why a downloaded asset was not accepted.
+#[derive(Debug, PartialEq, Eq)]
+enum VerifyError {
+    /// The release publishes sums, but not for this asset name.
+    NotListed,
+    /// The file on disk is not the file the release published.
+    Mismatch { expected: String, actual: String },
+    /// The file could not be read to hash it at all.
+    Unreadable(String),
+}
+
+impl std::fmt::Display for VerifyError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            VerifyError::NotListed => write!(f, "the release's SHA256SUMS does not list this asset"),
+            VerifyError::Mismatch { expected, actual } => write!(
+                f,
+                "checksum mismatch — expected {expected}, got {actual}"
+            ),
+            VerifyError::Unreadable(e) => write!(f, "the download could not be read back: {e}"),
+        }
+    }
+}
+
+/// Check a downloaded asset against the release's own `SHA256SUMS`.
+fn verify_asset_against_sums(
+    file: &std::path::Path,
+    sums: &str,
+    asset: &str,
+) -> Result<(), VerifyError> {
+    let expected = sha256_for_asset(sums, asset).ok_or(VerifyError::NotListed)?;
+    let actual = sha256_file(file).map_err(|e| VerifyError::Unreadable(e.to_string()))?;
+    if actual == expected {
+        Ok(())
+    } else {
+        Err(VerifyError::Mismatch { expected, actual })
+    }
+}
