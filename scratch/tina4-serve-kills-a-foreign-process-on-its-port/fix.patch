+    assert!(named.contains(&other.id().to_string()), "{}", named);
+    assert!(
+        !named.split(|c: char| !c.is_ascii_digit()).any(|t| t == me),
+        "the connected client was named as a holder: {}",
+        named
+    );
+    let _ = other.kill();
+    let _ = fs::remove_dir_all(&dir);
+}
