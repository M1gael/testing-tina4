.agents/

# `tina4 books` extracts to ./tina4-book/ at the cwd. Ignore stray root pulls.
/tina4-book/

# Local copy of tina4stack/tina4-book — either `tina4 books` or a symlink.
# Untracked: a committed symlink dangles in fresh clones, and a committed pull
# duplicates an upstream repo. Recreate with: mkdir -p documentation && tina4 books
/documentation/tina4-book
/documentation/tina4-book/*

# Agent rules for this wrapper. Local, not shared -- untracked with
# `git rm --cached CLAUDE.md`; the file stays on disk.
/CLAUDE.md
