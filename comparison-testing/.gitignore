# Virtual environments — 124 MB across the four Python apps, and rebuildable
# from each manifest's recorded package list. The measured install figures live
# in manifest.toml [install], so nothing is lost by not tracking these.
.venv/

# SQLite databases created by the apps at runtime.
*.db
*.sqlite3

# Byte-code caches. These are also why install size must be read BEFORE an app
# is first run — see readme.md rule 6.
__pycache__/
*.py[cod]

# Tina4 runtime output.
logs/
data/
.env.local

# Generated migrations are scaffolder output, not authored work, and are not
# counted (see each manifest). Django's live under the app package.
